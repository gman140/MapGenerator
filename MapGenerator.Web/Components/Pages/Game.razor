            _localMessages.Add(new ChatMessage
            {
                SenderName = "World", Content = result.RoomMessage,
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });

        if (result.ExitedToSurface)
        {
            _dungeonFloor = null;
            _revealedDungeonRooms = [];
        }
        else
        {
            _revealedDungeonRooms = [(result.NewQ, result.NewR)];
            if (result.RevealedRooms != null)
                foreach (var pos in result.RevealedRooms)
                    _revealedDungeonRooms.Add(pos);
