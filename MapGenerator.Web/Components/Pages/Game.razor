        {
            message = result.Gathered.Count == 0
                ? "You search the room thoroughly but find nothing useful."
                : result.Message + " You gather: " + string.Join(", ", result.Gathered.Select(g => $"{g.Quantity}× {g.Name}")) + ".";
        }
        else
        {
            message = result.Gathered.Count == 0
                ? "You search carefully but find nothing worth taking."
                : "You gather: " + string.Join(", ", result.Gathered.Select(g => $"{g.Quantity}× {g.Name}")) + ".";
