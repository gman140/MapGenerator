@page "/game"
@rendermode InteractiveServer
@inject GameSessionService Session
@inject GameBroadcastService Broadcast
@inject MapGeneratorService MapCache
@inject PermissionService PermissionSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ICraftingRecipeProvider RecipeProvider
@using MapGenerator.Application.Services
@using MapGenerator.Combat.Enums
@using MapGenerator.Combat.Models
@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Interfaces
@using MapGenerator.Domain.Models
@using MapGenerator.Web.Services
@implements IAsyncDisposable

<PageTitle>@(Session.Player?.Username ?? "World Map")</PageTitle>

@if (!Session.IsLoaded)
{
    <div class="loading-screen"><p>Loading&hellip;</p></div>
}
else if (Session.Player == null)
{
    <div class="loading-screen"><p>Redirecting&hellip;</p></div>
}
else
{
    <div class="game-layout">
        <div class="mobile-status-strip">
            <PlayerStatusBars Player="Session.Player" CooldownUntil="_cooldownUntil" />
            <div class="mobile-dungeon-actions">
                <DungeonActions IsOnDungeonEntrance="Session.IsOnDungeonEntrance()"
                                IsInDungeon="Session.Player.IsInDungeon"
                                IsOnStaircaseUp="_isOnStaircaseUp"
                                IsOnStaircaseDown="_isOnStaircaseDown"
                                IsOnFloorOne="Session.Player.DungeonFloor == 1"
                                HasRope="_playerHasRope"
                                OnEnterDungeon="HandleEnterDungeonAsync"
                                OnUseStaircase="HandleUseStaircaseAsync"
                                OnUseRope="HandleUseRopeAsync" />
            </div>
        </div>
        <div class="map-area">
            @if (Session.Player.IsInDungeon && _dungeonFloor != null)
            {
                <DungeonView Floor="_dungeonFloor"
                             PlayerQ="Session.Player.DungeonQ"
                             PlayerR="Session.Player.DungeonR"
                             FloorNumber="Session.Player.DungeonFloor"
                             PlayerColor="Session.Player.Color"
                             PlayerSprite="Session.Player.SpritePixels"
                             HasLantern="_playerHasLantern"
                             RevealedRooms="_revealedDungeonRooms"
                             OnRoomClicked="HandleDungeonRoomClickAsync" />
            }
            else
            {
                <HexMapView Player="Session.Player"
                            OnTileClicked="HandleTileClickAsync"
                            OnlinePlayers="Broadcast.GetOnlinePlayers()"
                            RevealedTiles="_revealedTiles" />
            }
        </div>
        <div class="sidebar @(_showMobileMore ? "mobile-open" : "")">
            <div class="mobile-sheet-header">
                <span class="mobile-sheet-title">Menu</span>
                <button class="mobile-sheet-close" @onclick='() => _showMobileMore = false'>✕</button>
            </div>
            <MiniMap Player="Session.Player" MapVersion="_mapVersion"
                     RevealedTiles="_revealedTiles" />
            <PlayerInfo Player="Session.Player"
                        CooldownUntil="_cooldownUntil"
                        LastKissedAt="Session.Player.LastKissedAt"
                        OnlinePlayers="Broadcast.GetOnlinePlayersOnTile(Session.Player.Q, Session.Player.R)"
                        OnEditSprite="() => _showSpriteEditor = true"
                        Companion="Session.Companion"
                        OnOpenCompanion="() => _showCompanionDialog = true"
                        HasCompanion="Session.Companion != null"
                        OnKissPlayer="HandleKissPlayerAsync"
                        OnBattlePlayer="HandleBattlePlayerAsync" />
            <button class="tutorial-open-btn" @onclick="() => _showTutorial = true">? Guide</button>
            <InventoryModal @ref="_inventoryModal"
                            Inventory="Session.Player.Inventory"
                            CraftedItems="Session.Player.CraftedItems"
                            EquippedWeaponId="@Session.Player.EquippedWeaponId"
                            EquippedArmorId="@Session.Player.EquippedArmorId"
                            EquippedHatId="@Session.Player.EquippedHatId"
                            OnUse="HandleUseAsync"
                            OnEquip="HandleEquipAsync"
                            OnUnequip="HandleUnequipAsync" />
            <CraftingPanel @ref="_craftingPanel" Player="Session.Player" OnCraft="HandleCraftAsync" />
            <FeedbackModal Username="@Session.Player.Username" IsAdmin="Session.Player.IsAdmin" />
            @if (!Session.Player.IsInDungeon)
            {
                <BuildMenu Player="Session.Player"
                           CurrentTile="MapCache.GetCachedTile(Session.Player.Q, Session.Player.R)"
                           OnBuild="HandleBuildStructureAsync"
                           OnDestroy="HandleDestroyStructureAsync"
                           OnBuildRoad="HandleBuildRoadAsync" />
            }
            <TileInventoryPanel Player="Session.Player" OnInventoryChanged="StateHasChanged" />
            @if (Session.Player.IsAdmin)
            {
                <TileEditorPanel CurrentTile="MapCache.GetCachedTile(Session.Player.Q, Session.Player.R)"
                                 OnSave="HandleEditTileAsync" />
                <button class="action-item admin-combat-btn" @onclick="HandleStartDebugCombatAsync"
                        disabled="@Session.Player.IsInCombat">
                    ⚔ Start Combat
                </button>
            }
            <ActionsMenu Player="Session.Player"
                         OnLayEgg="HandleLayEggAsync"
                         OnInvestigate="HandleInvestigateAsync"
                         OnGather="HandleGatherAsync"
OnDance="HandleDanceAsync"
                         OnLeaveNote="() => { _showNoteModal = true; _noteText = string.Empty; }"
                         OnPlantSign="() => { _showSignModal = true; _signText = string.Empty; }"
                         OnEnterDungeon="HandleEnterDungeonAsync"
                         OnUseRope="HandleUseRopeAsync"
                         OnUseStaircase="HandleUseStaircaseAsync"
                         LastEggLaidAt="Session.Player.LastEggLaidAt"
                         LastDancedAt="Session.Player.LastDancedAt"
                         GatherCooldownUntil="_gatherCooldownUntil"
                         TileHasResources="Session.Player.IsInDungeon || Session.TileHasResources()"
                         IsOnDungeonEntrance="Session.IsOnDungeonEntrance()"
                         IsInDungeon="Session.Player.IsInDungeon"
                         HasRope="_playerHasRope"
                         IsOnStaircaseUp="_isOnStaircaseUp"
                         IsOnStaircaseDown="_isOnStaircaseDown"
                         IsOnFloorOne="Session.Player.DungeonFloor == 1"
                         CooldownBypassed="PermissionSvc.GetPermissions(Session.Player).Contains(Permission.IgnoreCooldowns)"
                         TileHasEgg="Session.TileHasEgg()"
                         HasCompanion="Session.Player.CompanionId != null"
                         OnHatch="HandleHatchAsync" />
        </div>
        <div class="chat-area">
            <ChatPanel LocalMessages="_localMessages"
                       WorldMessages="_worldMessages"
                       OnSendLocal="SendLocalAsync"
                       OnSendWorld="SendWorldAsync" />
        </div>
    </div>

    @if (_showMobileMore)
    {
        <div class="mobile-sheet-backdrop" @onclick='() => _showMobileMore = false'></div>
    }
    <div class="mobile-action-bar">
        <button class="mobile-action-btn"
                disabled="@Session.Player.IsInCombat"
                @onclick="HandleInvestigateAsync">
            <span class="mab-icon">🔍</span>
            <span class="mab-label">Investigate</span>
        </button>
        <button class="mobile-action-btn"
                disabled="@(Session.Player.IsInCombat || !Session.TileHasResources() || DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() < _gatherCooldownUntil)"
                @onclick="HandleGatherAsync">
            <span class="mab-icon">⛏️</span>
            <span class="mab-label">Gather</span>
        </button>
        <button class="mobile-action-btn"
                @onclick='() => _craftingPanel?.Open()'>
            <span class="mab-icon">⚒️</span>
            <span class="mab-label">Crafting</span>
        </button>
        <button class="mobile-action-btn"
                @onclick='() => _inventoryModal?.Open()'>
            <span class="mab-icon">📋</span>
            <span class="mab-label">Inventory</span>
        </button>
        <button class="mobile-action-btn @(_showMobileMore ? "mab-active" : "")"
                @onclick='() => _showMobileMore = !_showMobileMore'>
            <span class="mab-icon">☰</span>
            <span class="mab-label">Menu</span>
        </button>
    </div>

    @if ((Session.Player.IsInCombat || _combatResult != null) && _combatSession != null)
    {
        <div class="combat-overlay">
            <CombatView @ref="_combatView"
                        Session="_combatSession"
                        PlayerSprite="Session.Player.SpritePixels"
                        PlayerName="@Session.Player.Username"
                        PlayerInventory="Session.Player.Inventory"
                        PlayerCraftedItems="Session.Player.CraftedItems"
                        CompanionSpritePixels="@Session.Companion?.SpritePixels"
                        CompanionName="@Session.Companion?.Nickname"
                        OnAction="HandleCombatActionAsync"
                        EndResult="_combatResult"
                        OnConfirmEnd="HandleCombatConfirmAsync"
                        IsAdmin="Session.Player.IsAdmin" />
        </div>
    }

    @if (_deathMessage != null)
    {
        <div class="death-overlay">
            <div class="death-modal">
                <div class="death-title">You Have Fallen</div>
                <p class="death-message">@_deathMessage</p>
                <button class="death-confirm-btn" @onclick="() => _deathMessage = null">I rise again...</button>
            </div>
        </div>
    }

    @if (_oceanWarning)
    {
        <div class="modal-overlay">
            <div class="modal-box danger">
                <p>The ocean is treacherous and vast. Venturing in without a vessel means certain death.</p>
                <p><strong>Are you sure you want to enter the ocean?</strong></p>
                <div class="modal-actions">
                    <button class="btn-danger" @onclick="ConfirmOceanAsync">Yes, I accept my fate</button>
                    <button @onclick="() => _oceanWarning = false">Turn back</button>
                </div>
            </div>
        </div>
    }


    @if (_showNoteModal)
    {
        <div class="modal-overlay" @onclick="() => _showNoteModal = false">
            <div class="modal-box" @onclick:stopPropagation>
                <h3 class="modal-title">Leave a Note</h3>
                <p class="modal-hint">Your note will be hidden here, discoverable only by those who investigate this tile.</p>
                <textarea class="modal-textarea" maxlength="200" placeholder="Write your note…"
                          @bind="_noteText" @bind:event="oninput" rows="4"></textarea>
                <div class="modal-char-count">@(_noteText?.Length ?? 0) / 200</div>
                <div class="modal-actions">
                    <button @onclick="HandleLeaveNoteAsync" disabled="@string.IsNullOrWhiteSpace(_noteText)">Leave Note</button>
                    <button @onclick="() => _showNoteModal = false">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (_showSignModal)
    {
        <div class="modal-overlay" @onclick="() => _showSignModal = false">
            <div class="modal-box" @onclick:stopPropagation>
                <h3 class="modal-title">Plant a Sign</h3>
                <p class="modal-hint">Your sign will be visible to anyone who enters this tile. It replaces any existing sign.</p>
                <textarea class="modal-textarea" maxlength="100" placeholder="Write your sign…"
                          @bind="_signText" @bind:event="oninput" rows="3"></textarea>
                <div class="modal-char-count">@(_signText?.Length ?? 0) / 100</div>
                <div class="modal-actions">
                    <button @onclick="HandlePlantSignAsync" disabled="@string.IsNullOrWhiteSpace(_signText)">Plant Sign</button>
                    <button @onclick="() => _showSignModal = false">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (_showTutorial)
    {
        <TutorialModal OnClose="() => _showTutorial = false" />
    }

    @if (_showSpriteEditor)
    {
        <SpriteEditorModal Player="Session.Player"
                           OnSave="HandleSpriteUpdateAsync"
                           OnCancel="() => _showSpriteEditor = false" />
    }

    @if (_showCompanionDialog && Session.Companion != null)
    {
        <CompanionDialog Companion="Session.Companion"
                         PlayerInventory="Session.Player?.Inventory ?? []"
                         OnSaveSprite="HandleCompanionSpriteAsync"
                         OnSaveNickname="HandleCompanionNicknameAsync"
                         OnSaveMoves="HandleCompanionMovesAsync"
                         OnUseElementalCore="HandleUseElementalCoreAsync"
                         OnUseEvolutionStone="HandleUseEvolutionStoneAsync"
                         OnCancel="() => _showCompanionDialog = false"
                         OnRelease="HandleReleaseAsync" />
    }

    <CompanionBattlePanel Challenge="_pendingBattleChallenge"
                          Result="_battleResult"
                          IsVictory="_battleVictory"
                          OnAccept="HandleBattleAcceptAsync"
                          OnDecline="HandleBattleDeclineAsync"
                          OnClose="() => { _battleResult = null; _battleVictory = null; }" />

    @if (_moveError != null)
    {
        <div class="toast-error">@_moveError</div>
    }
}

@code {
    private List<ChatMessage> _localMessages = [];
    private List<ChatMessage> _worldMessages = [];
    private long _cooldownUntil;
    private long _gatherCooldownUntil;
    private bool _oceanWarning;
    private bool _showTutorial;
    private string? _moveError;
    private (int q, int r)? _pendingOceanMove;
    private System.Threading.Timer? _toastTimer;
    private int _mapVersion;

    private HashSet<(int, int)>? _revealedTiles;

    private bool _showMobileMore;
    private CraftingPanel? _craftingPanel;
    private InventoryModal? _inventoryModal;
    private bool _showNoteModal;
    private bool _showSignModal;
    private bool _showSpriteEditor;
    private bool _showCompanionDialog;
    private string _noteText = string.Empty;
    private string _signText = string.Empty;

    // Combat state
    private CombatSession? _combatSession;
    private CombatResult? _combatResult;
    private CombatView? _combatView;
    private string? _deathMessage;
    private static readonly Random _deathRng = new();

    private static readonly string[] DeathMessages =
    [
        "The divine tribunal reviewed your life's ledger in meticulous detail and, after several celestial hours of deliberation, concluded that your earthly debts remain unsettled. You have been returned. Sort yourself out.",
        "The ferryman took one look at you, calculated what you owed, realized you had nothing to offer, and pointed back upstream. The River Styx does not extend credit. You washed ashore, gasping, back where you began.",
        "You arrived at the gates of eternity only to be informed, with profound regret, that the afterlife was at capacity. A waiting list has been started. You are number 4,719. Please return to the mortal realm and try again at a more convenient time.",
        "A minor deity of middling importance took pity upon your pathetic form — or perhaps it was disgust; the two are remarkably difficult to distinguish — and breathed life back into your wretched body. You are unsure whether to be grateful.",
        "The ancient spirits reviewed your case and determined, by a margin of three votes to two, that you are simply too annoying to admit into the afterlife. You have been sent back with a note that reads: 'Not yet. Please.'",
        "Death herself approached, reviewed your file, checked it twice, and discovered that you had not completed Form 7-Gamma, the Declaration of Mortal Intent. Your signature was absent. She sent you back. Do not misplace the form again.",
        "You were briefly welcomed into the celestial hall, where you promptly knocked over a very important urn, mispronounced the name of the eternal keeper three times, and broke an irreplaceable cosmic artifact. You were escorted out.",
        "The great worm at the center of existence tasted your soul, found it profoundly unsatisfying, and spat you back into the living world. It has since refused to comment on the incident.",
        "A prophet recorded, ages ago, that you would accomplish something of mild but notable significance before your end. The universe, bound by this prophecy, had no choice but to return you. The prophet has since issued a formal apology.",
        "Your guardian angel, who had been on an extended sabbatical in a considerably warmer realm, returned to find you dead and filed a strongly-worded complaint with the celestial administration. After several hours of appeals, they agreed to make an exception. Just this once.",
        "The lord of the underworld took one look at you, considered the paperwork involved, and said no. His exact words, as translated from the ancient tongue, amounted to something like: 'Absolutely not. Send it back.'",
        "You wandered into the realm of the dead and found it surprisingly bureaucratic. You filled out twelve forms, waited in three queues, and were ultimately rejected on a technicality. Apparently you had checked the wrong box on your mortality waiver.",
        "The shadows at the edge of death whispered to one another in hushed, horrified tones. Then they voted, unanimously, to send you back. Whatever they witnessed in your past deeds, they have refused to speak of it since.",
        "A very small and thoroughly obscure deity — one governing the domain of misplaced keys and wrong turns — interceded on your behalf for reasons that remain entirely unclear. You are now, technically, their chosen one. Neither of you asked for this.",
        "The cosmic ledger of fate was consulted. It said, in letters of ancient flame thirty feet high, that you were supposed to die next Tuesday. This was deemed close enough to warrant a temporary reinstatement.",
        "You arrived in the great beyond to discover that absolutely nobody there knew who you were or what you were doing there. After much confusion and several cups of celestial tea, they returned you to avoid the inconvenience of filing a missing-soul report.",
        "The afterlife's most senior official peered at you through spectacles older than mountains, murmured something about a 'loose end,' and had you escorted back to the living world. You are the loose end. What this implies remains, mercifully, unclear.",
        "You were dead for a period that theologians would describe as 'significant' and biologists would describe as 'impossible.' Nevertheless, here you are. Some forces in the universe are simply too stubborn to stay gone.",
    ];

    // Companion battle state
    private CompanionBattleChallenge? _pendingBattleChallenge;
    private CompanionBattleResult? _battleResult;
    private bool? _battleVictory; // null=draw, true=win, false=loss

    // Dungeon state
    private DungeonFloor? _dungeonFloor;
    private HashSet<(int Q, int R)> _revealedDungeonRooms = [];
    private bool _playerHasLantern => Session.Player != null &&
        (Session.Player.Inventory.GetValueOrDefault("Lantern") > 0 ||
         Session.Player.CraftedItems.GetValueOrDefault("Lantern") > 0);
    private bool _playerHasRope => Session.Player != null &&
        Session.Player.Inventory.GetValueOrDefault("Rope") > 0;
    private DungeonRoomType? _currentDungeonRoomType => _dungeonFloor?.Rooms
        .FirstOrDefault(r => r.Q == Session.Player!.DungeonQ && r.R == Session.Player.DungeonR)?.Type;
    private bool _isOnStaircaseUp   => _currentDungeonRoomType == DungeonRoomType.StaircaseUp;
    private bool _isOnStaircaseDown => _currentDungeonRoomType == DungeonRoomType.StaircaseDown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var browserId = await JS.InvokeAsync<string>("gameJs.getBrowserId");
        await Session.InitAsync(browserId);

        if (Session.Player == null)
        {
            Nav.NavigateTo("/");
            return;
        }

        _cooldownUntil       = Session.Player.MovementCooldownUntil;
        _gatherCooldownUntil = Session.Player.GatherCooldownUntil;
        _localMessages = await Session.GetTileChatAsync();
        AddArrivalMessages(Session.Player.Q, Session.Player.R);
        _worldMessages = await Session.GetWorldChatAsync();
        _revealedTiles = await Session.LoadRevealedTilesAsync();

        if (Session.Player.IsInCombat)
            _combatSession = await Session.GetActiveCombatAsync();

        if (Session.Player.IsInDungeon)
        {
            _dungeonFloor = await Session.GetCurrentDungeonFloorAsync();
            _revealedDungeonRooms = [(Session.Player.DungeonQ, Session.Player.DungeonR)];
        }

        Broadcast.PlayerMoved               += OnPlayerMoved;
        Broadcast.MessageReceived           += OnMessageReceived;
        Broadcast.MapRegenerated            += OnMapRegenerated;
        Broadcast.EggLaid                   += OnEggLaid;
        Broadcast.PlayerDanced              += OnPlayerDanced;
        Broadcast.PlayerKissed              += OnPlayerKissed;
        Broadcast.PlayerColorChanged        += OnPlayerColorChanged;
        Broadcast.RoadsChanged              += OnRoadsChanged;
        Broadcast.EggExploded               += OnEggExploded;
        Broadcast.CompanionChallengeReceived += OnCompanionChallengeReceived;
        Broadcast.CompanionChallengeDeclined += OnCompanionChallengeDeclined;
        Broadcast.CompanionBattleCompleted   += OnCompanionBattleCompleted;

        await JS.InvokeVoidAsync("gameJs.initMinimap", Session.Player.Q, Session.Player.R);
        StateHasChanged();
    }

    private async Task HandleBuildRoadAsync()
    {
        var (success, error) = await Session.BuildRoadAsync();
        if (!success) { ShowToast(error ?? "Cannot build road here."); return; }
        _localMessages.Add(new ChatMessage
        {
            SenderName = "World", Content = "You lay down a road here.",
            IsSystemMessage = true, SentAt = DateTime.UtcNow
        });
        StateHasChanged();
    }

    private async Task HandleTileClickAsync((int q, int r) target)
    {
        if (Session.Player == null) return;
        _moveError = null;

        var result = await Session.MoveAsync(target.q, target.r);

        if (result.RequiresOceanConfirmation)
        {
            _pendingOceanMove = target;
            _oceanWarning = true;
            StateHasChanged();
            return;
        }

        if (result.PlayerDrowned)
        {
            _deathMessage = DeathMessages[_deathRng.Next(DeathMessages.Length)];
            StateHasChanged();
            return;
        }

        if (!result.Success)
        {
            ShowToast(result.ErrorMessage ?? "Cannot move there.");
            return;
        }

        _cooldownUntil = result.CooldownUntil ?? 0;

        if (result.CombatStarted)
        {
            _combatSession = await Session.GetActiveCombatAsync();
            StateHasChanged();
            return;
        }

        _localMessages = await Session.GetTileChatAsync();
        AddArrivalMessages(Session.Player!.Q, Session.Player.R);
        await RevealTile(Session.Player.Q, Session.Player.R);
        await Session.ConsumeGardenProductionAsync();

        var (exploded, explosionMsg) = await Session.TryExplodeEggsAsync();
        if (exploded)
        {
            _localMessages.Add(new ChatMessage
            {
                SenderName = "World", Content = explosionMsg,
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });
            _mapVersion++;
        }

        await JS.InvokeVoidAsync("gameJs.updateMinimapPlayer", Session.Player.Q, Session.Player.R);
        StateHasChanged();
    }

    private async Task RevealTile(int q, int r)
    {
        if (_revealedTiles == null) return;
        _revealedTiles.Add((q, r));
        bool extended = Session.Player != null && RecipeProvider.PlayerHasEffect(Session.Player, ItemEffect.ExtendRevealRadius);
        var ring1 = new List<(int, int)>();
        foreach (var (dq, dr) in MapGeneratorService.HexNeighborOffsets())
        {
            int nq = q + dq, nr = r + dr;
            _revealedTiles.Add((nq, nr));
            ring1.Add((nq, nr));
            if (extended)
                foreach (var (dq2, dr2) in MapGeneratorService.HexNeighborOffsets())
                    _revealedTiles.Add((nq + dq2, nr + dr2));
        }
        _mapVersion++;
        if (extended)
            await Session.PersistRevealedCoordsAsync(ring1);
    }

    private void AddArrivalMessages(int q, int r)
    {
        var tile = MapCache.GetCachedTile(q, r);
        if (tile == null) return;

        if (tile.EggCount > 0)
            _localMessages.Add(new ChatMessage
            {
                SenderName = "World", Content = EggService.GetEggDescriptor(tile.EggCount),
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });

        if (!string.IsNullOrEmpty(tile.SignText))
            _localMessages.Add(new ChatMessage
            {
                SenderName = "World",
                Content = $"A sign planted by {tile.SignAuthor} reads: \"{tile.SignText}\"",
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });

        if (tile.Structure != null)
            _localMessages.Add(new ChatMessage
            {
                SenderName = "World",
                Content = $"A {StructureNames[tile.Structure.Type]} stands here, built by {tile.Structure.BuilderName}.",
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });
    }

    private static readonly Dictionary<StructureType, string> StructureNames = new()
    {
        [StructureType.Beacon]    = "Beacon",
        [StructureType.Garden]    = "Garden",
        [StructureType.MineShaft] = "Mine Shaft",
        [StructureType.Workshop]  = "Workshop",
        [StructureType.Dock]      = "Dock",
        [StructureType.Campfire]  = "Campfire",
    };

    private async Task ConfirmOceanAsync()
    {
        _oceanWarning = false;
        if (_pendingOceanMove == null) return;
        var (q, r) = _pendingOceanMove.Value;
        _pendingOceanMove = null;

        var result = await Session.MoveAsync(q, r, oceanConfirmed: true);
        if (result.PlayerDrowned)
        {
            _deathMessage = DeathMessages[_deathRng.Next(DeathMessages.Length)];
            StateHasChanged();
            return;
        }
        if (result.Success && Session.Player != null)
        {
            await RevealTile(Session.Player.Q, Session.Player.R);
            await JS.InvokeVoidAsync("gameJs.updateMinimapPlayer", Session.Player.Q, Session.Player.R);
        }
        StateHasChanged();
    }

    private async Task HandleLayEggAsync()
    {
        var (_, message, _) = await Session.LayEggAsync();
        _localMessages.Add(new ChatMessage
        {
            SenderName = "World", Content = message,
            IsSystemMessage = true, SentAt = DateTime.UtcNow
        });
        StateHasChanged();
    }

    private async Task HandleDanceAsync()
    {
        var (success, message, _, _) = await Session.DanceAsync();
        if (!success) return;
        _localMessages.Add(new ChatMessage
        {
            SenderName = "World", Content = message,
            IsSystemMessage = true, SentAt = DateTime.UtcNow
        });
        StateHasChanged();
    }

    private async Task HandleBuildStructureAsync(StructureType type)
    {
        var (success, error) = await Session.BuildStructureAsync(type);
        if (!success)
        {
            ShowToast(error ?? "Cannot build here.");
            return;
        }
        var tile = MapCache.GetCachedTile(Session.Player!.Q, Session.Player.R);
        var structureName = StructureNames.GetValueOrDefault(type, type.ToString());
        _localMessages.Add(new ChatMessage
        {
            SenderName = "World", Content = $"You build a {structureName} here.",
            IsSystemMessage = true, SentAt = DateTime.UtcNow
        });
        if (type == StructureType.Beacon) _mapVersion++;
        StateHasChanged();
    }

    private async Task HandleDestroyStructureAsync()
    {
        var tile = MapCache.GetCachedTile(Session.Player!.Q, Session.Player.R);
        var structureType = tile?.Structure?.Type;
        var success = await Session.DestroyStructureAsync();
        if (!success) return;
        var structureName = structureType.HasValue ? StructureNames.GetValueOrDefault(structureType.Value, structureType.ToString()!) : "structure";
        _localMessages.Add(new ChatMessage
        {
            SenderName = "World", Content = $"You tear down the {structureName}.",
            IsSystemMessage = true, SentAt = DateTime.UtcNow
        });
        if (structureType == StructureType.Beacon) _mapVersion++;
        StateHasChanged();
    }

