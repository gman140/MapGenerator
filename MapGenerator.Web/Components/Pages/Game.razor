    private async Task HandleDungeonRoomClickAsync((int Q, int R) target)
    {
        if (Session.Player == null) return;
        var result = await Session.DungeonMoveAsync(target.Q, target.R);

        if (!result.Success)
        {
            ShowToast(result.ErrorMessage ?? "Cannot move there.");
            return;
        }

        if (result.CombatStarted)
        {
            _combatSession = await Session.GetActiveCombatAsync();
            if (result.RoomMessage != null)
                _localMessages.Add(new ChatMessage
                {
                    SenderName = "World", Content = result.RoomMessage,
                    IsSystemMessage = true, SentAt = DateTime.UtcNow
                });
            StateHasChanged();
            return;
        }

        if (result.RoomMessage != null)
            _localMessages.Add(new ChatMessage
            {
                SenderName = "World", Content = result.RoomMessage,
                IsSystemMessage = true, SentAt = DateTime.UtcNow
            });

        if (result.ExitedToSurface)
        {
            _dungeonFloor = null;
            _revealedDungeonRooms = [];
        }
        else
        {
            _revealedDungeonRooms.Add((result.NewQ, result.NewR));
            if (result.RevealedRooms != null)
                foreach (var pos in result.RevealedRooms)
                    _revealedDungeonRooms.Add(pos);

            // Reload floor data if floor changed
            _dungeonFloor = await Session.GetCurrentDungeonFloorAsync();
        }

        _gatherCooldownUntil = Session.Player.GatherCooldownUntil;
        StateHasChanged();
    }

    // ── Combat ────────────────────────────────────────────────────────────────

    private async Task HandleCombatActionAsync(CombatAction action)
    {
        if (Session.Player == null || _combatSession == null) return;

        var turnResult = await Session.ProcessCombatTurnAsync(action);
        if (turnResult == null) return;

        // Replay events against the display session so animations and bar changes
        // happen at the right moment rather than all jumping to the final state at once.
        foreach (var evt in turnResult.Events)
        {
            // Apply state changes to the display session
            if (evt.PlayerHp >= 0)        _combatSession.PlayerHp       = evt.PlayerHp;
            if (evt.PlayerStamina >= 0)   _combatSession.PlayerStamina  = evt.PlayerStamina;
            if (evt.PlayerMana >= 0)      _combatSession.PlayerMana     = evt.PlayerMana;
            if (evt.PlayerDefending != null) _combatSession.PlayerDefending = evt.PlayerDefending.Value;
            if (evt.PlayerSteady    != null) _combatSession.PlayerSteady    = evt.PlayerSteady.Value;
            if (evt.EnemyHp >= 0 && evt.EnemyInstanceId != null)
            {
                var e = _combatSession.Enemies.FirstOrDefault(e => e.InstanceId == evt.EnemyInstanceId);
                if (e != null) e.CurrentHp = evt.EnemyHp;
            }
            if (evt.Log != null)
                _combatSession.Log.Add(evt.Log);

            // Trigger animations
            switch (evt.Kind)
            {
                case CombatEventKind.PlayerAttack:
                    _combatView?.TriggerPlayerAttack();
                    break;
                case CombatEventKind.PlayerBounce:
                    _combatView?.TriggerPlayerBounce();
                    break;
                case CombatEventKind.CompanionAction:
                    _combatView?.TriggerCompanionAttack();
                    break;
                case CombatEventKind.CompanionBounce:
                    _combatView?.TriggerCompanionBounce();
                    break;
                case CombatEventKind.EnemyBounce when evt.EnemyInstanceId != null:
                    _combatView?.TriggerEnemyBounce(evt.EnemyInstanceId);
                    break;
                case CombatEventKind.ShakePlayer:
                    _combatView?.TriggerPlayerShake(evt.EnemyInstanceId);
                    break;
                case CombatEventKind.ShakeEnemy when evt.EnemyInstanceId != null:
                    _combatView?.TriggerEnemyShake(evt.EnemyInstanceId);
                    break;
                case CombatEventKind.PlayerUpdate:
                    _combatSession.ActiveModifiers = turnResult.Session.ActiveModifiers;
                    break;
                case CombatEventKind.StatusApplied:
                {
                    if (evt.EnemyInstanceId != null)
                    {
                        var src = turnResult.Session.Enemies.FirstOrDefault(e => e.InstanceId == evt.EnemyInstanceId);
                        var dst = _combatSession.Enemies.FirstOrDefault(e => e.InstanceId == evt.EnemyInstanceId);
                        if (src != null && dst != null) dst.ActiveModifiers = src.ActiveModifiers;
                    }
                    else
                    {
                        _combatSession.ActiveModifiers = turnResult.Session.ActiveModifiers;
                    }
                    break;
                }
                case CombatEventKind.PlayerMagicCast:
                    _combatView?.TriggerPlayerMagicCast();
                    break;
                case CombatEventKind.PlayerMagicHeal:
                    _combatView?.TriggerPlayerMagicHeal();
                    break;
                case CombatEventKind.ShakeMagicEnemy when evt.EnemyInstanceId != null:
                    _combatView?.TriggerMagicEnemyShake(evt.EnemyInstanceId);
                    break;
                case CombatEventKind.EnemyDied when evt.EnemyInstanceId != null && _combatView != null:
                    StateHasChanged();
                    await _combatView.TriggerEnemyDieAsync(evt.EnemyInstanceId);
                    break;
                case CombatEventKind.EnemyFled when evt.EnemyInstanceId != null && _combatView != null:
                {
                    StateHasChanged();
                    await _combatView.TriggerEnemyFleeAsync(evt.EnemyInstanceId);
                    var fled = _combatSession.Enemies.FirstOrDefault(e => e.InstanceId == evt.EnemyInstanceId);
                    if (fled != null) fled.HasFled = true;
                    break;
                }
            }

            if (evt.DelayMs > 0)
            {
                StateHasChanged();
                await Task.Delay(evt.DelayMs);
            }
        }

        // Sync display session to final persisted state
        _combatSession = turnResult.Session;

        bool finished = _combatSession.Phase is CombatPhase.Victory or CombatPhase.Defeat;
        if (finished)
            _combatResult = await Session.GetPendingCombatResultAsync();

        StateHasChanged();
    }

    private async Task HandleCombatConfirmAsync()
    {
        bool playerDied = _combatResult?.PlayerDied == true && !(Session.Player?.IsAdmin ?? false);
        if (playerDied)
            _deathMessage = DeathMessages[_deathRng.Next(DeathMessages.Length)];

        await Session.FinalizeCombatAsync();
        _combatSession = null;
        _combatResult  = null;

        if (!playerDied && Session.Player!.IsInDungeon)
            _dungeonFloor = await Session.GetCurrentDungeonFloorAsync();

        StateHasChanged();
    }

