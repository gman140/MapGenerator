@using MapGenerator.Domain.Models
@using MapGenerator.Web.Services
@using MapGenerator.Combat.Interfaces
@using MapGenerator.Combat.Services
@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Interfaces
@inject GameSessionService Session
@inject IEnemyDefinitionProvider EnemyProvider
@inject IEquipmentDefinitionProvider EquipmentProvider

<div class="modal-overlay" @onclick="HandleCancel">
    <div class="sprite-editor-modal" @onclick:stopPropagation
         @onmouseup="() => _isPainting = false"
         @oncontextmenu:preventDefault>
        <h3 class="modal-title">Character</h3>

        <div class="sprite-editor-tabs">
            <button class="sprite-tab @(_tab == "stats" ? "active" : "")" @onclick='() => _tab = "stats"'>Stats</button>
            <button class="sprite-tab @(_tab == "sprite" ? "active" : "")" @onclick='() => _tab = "sprite"'>Sprite</button>
            <button class="sprite-tab @(_tab == "bestiary" ? "active" : "")" @onclick='() => _tab = "bestiary"'>Bestiary</button>
        </div>

        @if (_tab == "stats")
        {
            int xpForNext = Player.Level < 20 ? Player.Level * 60 : 1;
            double xpPct  = Player.Level < 20 ? Math.Min(100, Player.Experience * 100.0 / xpForNext) : 100;

            <div class="pstab-level-row">
                <span class="pstab-level">Level @Player.Level</span>
                <div class="pstab-xp-bar">
                    <div class="pstab-xp-fill" style="width: @xpPct.ToString("F1")%"></div>
                </div>
                @if (Player.Level < 20)
                {
                    <span class="pstab-xp-text">@Player.Experience / @xpForNext XP</span>
                }
                else
                {
                    <span class="pstab-xp-text">MAX</span>
                }
            </div>

            <div class="pstab-points-row">
                <span class="pstab-points-label">Unspent Points</span>
                <span class="pstab-points-value @(Player.UnspentStatPoints > 0 ? "has-points" : "")">
                    @Player.UnspentStatPoints
                </span>
            </div>

            @if (_statError != null)
            {
                <div class="pstab-error">@_statError</div>
            }

            <div class="pstab-stats">
                @StatRow("MaxHp", "Max HP", Player.MaxHp.ToString(), "1 pt = +2 HP")
                @StatRow("BaseAttack", "Attack", Player.BaseAttack.ToString(), null)
                @StatRow("BaseDefense", "Defense", Player.BaseDefense.ToString(), null)
                @StatRow("BaseResistance", "Resistance", Player.BaseResistance.ToString(), "vs energy attacks")
                @StatRow("BaseMagic", "Magic", Player.BaseMagic.ToString(), null)
                @StatRow("BaseSpeed", "Speed", Player.BaseSpeed.ToString(), null)
                @StatRow("BaseCritChance", "Crit", $"{Player.BaseCritChance * 100:F0}%", null)
            </div>

            @if (Player.EquippedWeaponId != null || Player.EquippedArmorId != null || Player.EquippedHatId != null)
            {
                <div class="pstab-equip-section">
                    <span class="pstab-equip-title">Equipment</span>
                    @EquipRow("⚔️", Player.EquippedWeaponId)
                    @EquipRow("🛡️", Player.EquippedArmorId)
                    @EquipRow("🎩", Player.EquippedHatId)
                </div>
            }

            <div class="pstab-footnote">Tier costs: purchases 1–5 cost 1 pt · 6–10 cost 2 pts · 11+ cost 3 pts</div>

            <div class="modal-actions">
                <button @onclick="HandleCancel">Close</button>
            </div>
        }
        else if (_tab == "bestiary")
        {
            var discovered = EnemyProvider.All
                .Where(d => Player.EnemiesDefeated.ContainsKey(d.Id))
                .OrderByDescending(d => Player.EnemiesDefeated[d.Id])
                .ToList();
            <div class="bestiary-list">
                @if (discovered.Count == 0)
                {
                    <p class="bestiary-empty">No entries yet — defeat an enemy to unlock its bestiary entry.</p>
                }
                else
                {
                    @foreach (var def in discovered)
                    {
                        int kills = Player.EnemiesDefeated[def.Id];
                        var locations = EnemySpawner.GetLocations(def.Id);
                        <div class="bestiary-entry">
                            <div class="bestiary-sprite">
                                <EnemySprite DefinitionId="@def.Id" />
                            </div>
                            <div class="bestiary-info">
                                <div class="bestiary-name">
                                    @def.Name
                                    <span class="bestiary-kills">× @kills defeated</span>
                                </div>
                                @if (!string.IsNullOrEmpty(def.Description))
                                {
                                    <p class="bestiary-desc">@def.Description</p>
                                }
                                @if (locations.Length > 0)
                                {
                                    <div class="bestiary-tags">
                                        @foreach (var loc in locations)
                                        {
                                            bool isDungeon = loc.Contains("Dungeon");
                                            <span class="bestiary-location @(isDungeon ? "dungeon" : "")">@loc</span>
                                        }
                                    </div>
                                }
                                @if (def.Weaknesses.Count > 0 || def.Resistances.Count > 0)
                                {
                                    <div class="bestiary-tags">
                                        @foreach (var w in def.Weaknesses)
                                        {
                                            <span class="bestiary-weak">⚡ @w</span>
                                        }
                                        @foreach (var r in def.Resistances)
                                        {
                                            <span class="bestiary-resist">🛡 @r</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="modal-actions">
                <button @onclick="HandleCancel">Close</button>
            </div>
        }
        else
        {
            <div class="sprite-editor-body"
                 @onmouseleave="() => _isPainting = false">
                <div class="sprite-grid-wrap">
                    <div class="sprite-grid"
                         @onmouseup="() => _isPainting = false">
                        @for (int i = 0; i < 256; i++)
                        {
                            int idx = i;
                            string fill = string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : _pixels[idx];
                            <div class="sprite-cell @(string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : "")"
                                 style="background: @fill"
                                 @onmousedown="(e) => HandleMouseDown(idx, e)"
                                 @onmouseenter="() => { if (_isPainting) ApplyPaint(idx); }"
                                 @oncontextmenu:preventDefault>
                            </div>
                        }
                    </div>
                </div>

                <div class="sprite-preview-wrap">
                    <div class="sprite-preview-label">Preview</div>
                    <svg width="64" height="64" class="sprite-preview-svg">
                        @for (int i = 0; i < 256; i++)
                        {
                            if (!string.IsNullOrEmpty(_pixels[i]))
                            {
                                int px = i % 16, py = i / 16;
                                <rect x="@(px * 4)" y="@(py * 4)" width="4" height="4" fill="@_pixels[i]" />
                            }
                        }
                    </svg>
                </div>
            </div>

            <div class="sprite-editor-tools">
                <label class="sprite-tool-label">
                    Color
                    <input type="color" class="sprite-color-input" value="@_hexColor" @onchange="HandleColorChange" />
                </label>
                <label class="sprite-tool-label">
                    Opacity
                    <input type="range" min="0" max="255" value="@_alpha" class="sprite-alpha-slider"
                           @onchange="HandleAlphaChange" />
                    <span class="sprite-alpha-value">@((int)Math.Round(_alpha / 255.0 * 100))%</span>
                </label>
                <button class="sprite-tool-btn @(_erasing ? "active" : "")"
                        @onclick="() => { _erasing = !_erasing; }">
                    @(_erasing ? "✏ Paint" : "⬜ Erase")
                </button>
                <button class="sprite-tool-btn" @onclick="ApplyDefault">Default</button>
                <button class="sprite-tool-btn" @onclick="ClearAll">Clear All</button>
            </div>

            @if (_saveError != null)
            {
                <div class="sprite-save-error">@_saveError</div>
            }

            <div class="modal-actions">
                <button @onclick="HandleCancel">Cancel</button>
                <button class="btn-primary" @onclick="HandleSave">Save</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public string InitialTab { get; set; } = "sprite";
    [Parameter] public EventCallback<string[]> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _tab = "sprite";
    private string[] _pixels = new string[256];
    private string _hexColor = "#ffffff";
    private double _alpha = 255;
    private bool _erasing;
    private bool _isPainting;
    private bool _paintingAsErase;
    private string? _saveError;
    private string? _statError;

    protected override void OnParametersSet()
    {
        if (_pixels.All(p => p == null))
        {
            Reset();
            _tab = InitialTab;
        }
    }

    protected override void OnInitialized()
    {
        Reset();
        _tab = InitialTab;
    }

    private void Reset()
    {
        _pixels = new string[256];
        var src = Player.SpritePixels;
        for (int i = 0; i < 256 && i < src.Length; i++)
            _pixels[i] = src[i] ?? "";
        _hexColor = Player.Color.Length >= 7 ? Player.Color[..7] : Player.Color;
        _alpha = 255;
    }

    private RenderFragment StatRow(string stat, string label, string value, string? hint) => __builder =>
    {
        int purchases = Player.StatPurchases.GetValueOrDefault(stat);
        int cost = GameSessionService.GetStatPointCost(stat, purchases);
        bool canAfford = Player.UnspentStatPoints >= cost;

        <div class="pstab-stat-row">
            <span class="pstab-stat-label">@label</span>
            <span class="pstab-stat-value">@value</span>
            @if (hint != null) { <span class="pstab-stat-hint">(@hint)</span> }
            <button class="pstab-spend-btn @(canAfford ? "" : "disabled")"
                    disabled="@(!canAfford)"
                    @onclick="async () => await BuyStatAsync(stat)">
                @cost pt
            </button>
        </div>
    };

    private async Task BuyStatAsync(string stat)
    {
        _statError = null;
        var err = await Session.AllocateStatPointAsync(stat);
        if (err != null) { _statError = err; return; }
        StateHasChanged();
    }

    private void HandleMouseDown(int idx, MouseEventArgs e)
    {
        _isPainting = true;
        _paintingAsErase = e.Button == 2;
        ApplyPaint(idx);
        StateHasChanged();
    }

    private void ApplyPaint(int idx)
    {
        _pixels[idx] = (_erasing || _paintingAsErase) ? "" : BuildColor();
        StateHasChanged();
    }

    private void ApplyDefault()
    {
        _pixels = GameSessionService.GenerateDefaultSprite(BuildColor());
    }

    private string BuildColor()
    {
        int a = (int)Math.Clamp(Math.Round(_alpha), 0, 255);
        return _hexColor + a.ToString("x2");
    }

    private void HandleColorChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val))
            _hexColor = val;
        _erasing = false;
    }

    private void HandleAlphaChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double v))
            _alpha = v;
    }

    private void ClearAll()
    {
        for (int i = 0; i < 256; i++)
            _pixels[i] = "";
    }

    private async Task HandleSave()
    {
        int filled = _pixels.Count(p => !string.IsNullOrEmpty(p));
        if (filled < 50)
        {
            _saveError = $"At least 50 pixels must be painted ({filled} currently set).";
            return;
        }
        _saveError = null;
        await OnSave.InvokeAsync([.. _pixels]);
    }

    private RenderFragment EquipRow(string icon, string? itemId) => __builder =>
    {
        if (itemId == null) return;
        var def = EquipmentProvider.GetById(itemId);
        if (def == null) return;
        string stats = FormatEquipStats(def);
        <div class="pstab-equip-row">
            <span>@icon</span>
            <span class="pstab-equip-name">@def.Name</span>
            @if (!string.IsNullOrEmpty(stats))
            {
                <span class="pstab-equip-stats">@stats</span>
            }
        </div>
    };

    private static string FormatEquipStats(EquipmentDefinition def)
    {
        var parts = new List<string>();
        foreach (var affix in def.Affixes)
        {
            parts.Add(affix.Stat switch
            {
                ModifierStat.Attack      => $"+{(int)affix.Value} Atk",
                ModifierStat.Magic       => $"+{(int)affix.Value} Mag",
                ModifierStat.Defense     => $"+{(int)affix.Value} Def",
                ModifierStat.Resistance  => $"+{(int)affix.Value} Res",
                ModifierStat.Accuracy    => $"{affix.Value * 100:+0;-0}% Accuracy",
                ModifierStat.Speed       => $"+{(int)affix.Value} Speed",
                ModifierStat.StaminaRegen=> $"+{(int)affix.Value} Stam/turn",
                ModifierStat.ManaRegen   => $"+{(int)affix.Value} Mana/turn",
                ModifierStat.HpRegen     => $"+{(int)affix.Value} HP/turn",
                ModifierStat.HealBonus   => $"+{affix.Value * 100:F0}% Heal",
                _                        => $"+{affix.Value} {affix.Stat}",
            });
        }
        if (def.EquipmentSlot == "Weapon")
            parts.Add(FormatDamageType(def.WeaponDamageType));
        return string.Join(" · ", parts);
    }

    private static string FormatDamageType(DamageType dt) => dt switch
    {
        DamageType.Bludgeoning => "🔨 Bludgeoning",
        DamageType.Piercing    => "🏹 Piercing",
        DamageType.Slashing    => "⚔️ Slashing",
        DamageType.Fire        => "🔥 Fire",
        DamageType.Frost       => "❄️ Frost",
        DamageType.Storm       => "⚡ Storm",
        DamageType.Nature      => "🌿 Nature",
        DamageType.Dark        => "🌑 Dark",
        _                      => dt.ToString(),
    };

    private async Task HandleCancel() => await OnCancel.InvokeAsync();
}
