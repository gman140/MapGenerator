<span class="@Class" style="display:inline-block;line-height:0">
<svg width="100" height="100" class="@AffixClass">
    @if (DefinitionId == "Slime")
    {
        <ellipse cx="50" cy="58" rx="28" ry="20" fill="#3a8a3a" stroke="@Stroke" stroke-width="@Sw" />
    }
    else if (DefinitionId == "SentientEgg")
    {
        <ellipse cx="50" cy="55" rx="22" ry="30" fill="#c8b400" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="43" cy="48" r="3" fill="#222" />
        <circle cx="57" cy="48" r="3" fill="#222" />
    }
    else if (DefinitionId == "HexRabbit")
    {
        <ellipse cx="50" cy="60" rx="16" ry="13" fill="#b0a080" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="44" cy="44" rx="4" ry="10" fill="#b0a080" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="56" cy="44" rx="4" ry="10" fill="#b0a080" stroke="@Stroke" stroke-width="@Sw" />
        <line x1="38" y1="70" x2="38" y2="73" stroke="@Stroke" stroke-width="2" />
        <line x1="50" y1="70" x2="50" y2="76" stroke="@Stroke" stroke-width="2" />
        <line x1="62" y1="70" x2="62" y2="73" stroke="@Stroke" stroke-width="2" />
    }
    else if (DefinitionId == "BeaverSerpent")
    {
        <rect x="28" y="50" width="44" height="25" rx="8" fill="#7a6040" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="50" cy="40" rx="14" ry="9" fill="#5a8050" stroke="@Stroke" stroke-width="@Sw" />
        <line x1="50" y1="33" x2="46" y2="28" stroke="#c04040" stroke-width="1.5" />
        <line x1="50" y1="33" x2="54" y2="28" stroke="#c04040" stroke-width="1.5" />
        <ellipse cx="50" cy="82" rx="18" ry="7" fill="#6a5030" stroke="@Stroke" stroke-width="@Sw" />
    }
    else if (DefinitionId == "MushroomSprite")
    {
        <rect x="44" y="58" width="12" height="20" rx="4" fill="#d4c0a0" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="50" cy="52" rx="24" ry="14" fill="#c04060" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="43" cy="48" r="3" fill="rgba(255,255,255,0.47)" />
        <circle cx="54" cy="44" r="4" fill="rgba(255,255,255,0.47)" />
        <circle cx="62" cy="50" r="2.5" fill="rgba(255,255,255,0.47)" />
    }
    else if (DefinitionId == "DustWraith")
    {
        <ellipse cx="50" cy="72" rx="22" ry="10" fill="#c8b880" opacity="0.6" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="50" cy="55" rx="14" ry="9" fill="#c8b880" opacity="0.75" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="50" cy="40" rx="8" ry="8" fill="#e0d090" opacity="0.9" stroke="@Stroke" stroke-width="@Sw" />
    }
    else if (DefinitionId == "Wolf")
    {
        <polygon points="50,20 72,50 65,80 35,80 28,50" fill="#888" stroke="@Stroke" stroke-width="@Sw" />
    }
    else if (DefinitionId == "Bear")
    {
        <rect x="18" y="22" width="64" height="58" rx="12" fill="#8B4513" stroke="@Stroke" stroke-width="@Sw" />
    }
    else if (DefinitionId == "TwiceBornHeron")
    {
        <ellipse cx="50" cy="68" rx="11" ry="18" fill="#8898b8" stroke="@Stroke" stroke-width="@Sw" />
        <rect x="46" y="36" width="8" height="26" rx="4" fill="#8898b8" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="50" cy="30" rx="9" ry="9" fill="#8898b8" stroke="@Stroke" stroke-width="@Sw" />
        <polygon points="50,58 18,46 24,72" fill="#6878a0" stroke="@Stroke" stroke-width="@Sw" />
        <polygon points="50,58 82,46 76,72" fill="#6878a0" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="46" cy="28" r="2.5" fill="#c04040" />
        <circle cx="54" cy="28" r="2.5" fill="#c04040" />
    }
    else if (DefinitionId == "StoneShepherd")
    {
        <rect x="20" y="38" width="60" height="48" rx="4" fill="#7a7870" stroke="@Stroke" stroke-width="@Sw" />
        <rect x="28" y="18" width="44" height="24" rx="3" fill="#7a7870" stroke="@Stroke" stroke-width="@Sw" />
        <rect x="6" y="40" width="14" height="34" rx="3" fill="#7a7870" stroke="@Stroke" stroke-width="@Sw" />
        <rect x="80" y="40" width="14" height="34" rx="3" fill="#7a7870" stroke="@Stroke" stroke-width="@Sw" />
        <line x1="38" y1="44" x2="43" y2="64" stroke="#5a5852" stroke-width="1.5" />
        <line x1="58" y1="50" x2="55" y2="70" stroke="#5a5852" stroke-width="1.5" />
    }
    else if (DefinitionId == "PaleLibrarian")
    {
        <polygon points="36,22 64,22 72,90 28,90" fill="#d0ccc0" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="50" cy="14" r="10" fill="#c8c4b8" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="46" cy="13" r="2.5" fill="#3a3530" />
        <circle cx="54" cy="13" r="2.5" fill="#3a3530" />
        <rect x="60" y="46" width="14" height="20" rx="1" fill="#7a5a38" stroke="#5a4028" stroke-width="1" />
        <line x1="67" y1="46" x2="67" y2="66" stroke="#5a4028" stroke-width="1" />
    }
    else if (DefinitionId == "FermentedThing")
    {
        <polygon points="50,16 64,20 76,30 80,46 74,62 62,76 48,80 34,75 22,63 18,46 24,30 36,18" fill="#4a6030" stroke="@Stroke" stroke-width="@Sw" />
        <ellipse cx="54" cy="85" rx="5" ry="7" fill="#4a6030" />
        <circle cx="38" cy="34" r="4" fill="#5a7040" />
        <circle cx="63" cy="28" r="3" fill="#5a7040" />
        <circle cx="68" cy="52" r="4.5" fill="#5a7040" />
    }
    else if (DefinitionId == "TheArrangement")
    {
        <rect x="12" y="14" width="14" height="28" rx="2" fill="#b0a080" stroke="@Stroke" stroke-width="@Sw" />
        <rect x="8" y="40" width="22" height="7" rx="2" fill="#b0a080" stroke="@Stroke" stroke-width="@Sw" />
        <line x1="12" y1="47" x2="10" y2="64" stroke="#b0a080" stroke-width="2" />
        <line x1="27" y1="47" x2="29" y2="64" stroke="#b0a080" stroke-width="2" />
        <circle cx="52" cy="22" r="13" fill="#90b0cc" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="47" cy="17" r="4" fill="#c0d8ec" opacity="0.5" />
        <rect x="64" y="44" width="24" height="20" rx="2" fill="#c09040" stroke="@Stroke" stroke-width="@Sw" />
        <line x1="76" y1="44" x2="76" y2="64" stroke="#a07030" stroke-width="1" />
        <line x1="64" y1="54" x2="88" y2="54" stroke="#a07030" stroke-width="1" />
    }
    else if (DefinitionId == "CoronatedRat")
    {
        <ellipse cx="50" cy="66" rx="22" ry="18" fill="#8a7a68" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="50" cy="44" r="15" fill="#8a7a68" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="37" cy="33" r="7" fill="#8a7a68" stroke="@Stroke" stroke-width="@Sw" />
        <circle cx="63" cy="33" r="7" fill="#8a7a68" stroke="@Stroke" stroke-width="@Sw" />
        <polygon points="36,32 40,18 45,28 50,14 55,28 60,18 64,32" fill="#d4a020" stroke="#b08000" stroke-width="1.5" />
        <circle cx="50" cy="18" r="2.5" fill="#c04040" />
        <circle cx="41" cy="21" r="2" fill="#4080c0" />
        <circle cx="59" cy="21" r="2" fill="#40c040" />
        <circle cx="45" cy="43" r="2.5" fill="#1a0000" />
        <circle cx="55" cy="43" r="2.5" fill="#1a0000" />
    }
    else
    {
        <polygon points="50,10 70,28 80,55 65,85 35,85 20,55 30,28" fill="#4a4a3a" stroke="@Stroke" stroke-width="@Sw" />
    }
</svg>
</span>

@code {
    [Parameter, EditorRequired] public string DefinitionId { get; set; } = string.Empty;
    [Parameter] public bool Targeted { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? Affix { get; set; }

    private string Stroke     => Targeted ? "#ffe066" : "#aaa";
    private string Sw         => Targeted ? "3" : "1.5";
    private string AffixClass => string.IsNullOrEmpty(Affix) ? string.Empty : $"affix-{Affix}";
}
