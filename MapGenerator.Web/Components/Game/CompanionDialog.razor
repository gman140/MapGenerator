@using MapGenerator.Combat.Enums
@using MapGenerator.Combat.Models
@using MapGenerator.Combat.Interfaces
@using MapGenerator.Domain.Models
@using MapGenerator.Domain.Enums
@using MapGenerator.Web.Services
@inject ICompanionMoveProvider MoveProvider
@inject ICompanionDefinitionProvider DefProvider

<div class="modal-overlay" @onclick="HandleCancel">
    <div class="companion-dialog" @onclick:stopPropagation
         @onmouseup="() => _isPainting = false"
         @oncontextmenu:preventDefault>

        <div class="companion-dialog-titlebar">
            <span class="companion-dialog-name">@Companion.Nickname</span>
            <span class="companion-tier-badge tier-@Companion.Tier.ToString().ToLower()">
                @Companion.Tier @TierRegistry.Get(Companion.Tier).DisplayName
            </span>
        </div>

        <div class="sprite-editor-tabs">
            <button class="sprite-tab @(_tab == "stats"   ? "active" : "")" @onclick='() => _tab = "stats"'>Stats</button>
            <button class="sprite-tab @(_tab == "moves"   ? "active" : "")" @onclick='() => { _tab = "moves"; _pickerSlot = -1; }'>Moves</button>
            <button class="sprite-tab @(_tab == "sprite"  ? "active" : "")" @onclick='() => _tab = "sprite"'>Sprite</button>
        </div>

        @if (_tab == "stats")
        {
            <div class="companion-stats-body">
                <p class="companion-desc">@Companion.Description</p>

                @* Temperament *@
                <div class="companion-stat-row">
                    <span class="companion-stat-label">Temperament</span>
                    <span class="companion-temperament-badge temp-@Companion.Temperament.ToString().ToLower()">
                        @Companion.Temperament
                    </span>
                    <span class="companion-temp-hint">@TemperamentHint</span>
                </div>

                @* Element types *@
                <div class="companion-stat-row">
                    <span class="companion-stat-label">Element</span>
                    <span class="companion-element-row">
                        @foreach (var et in EffectiveElementTypes)
                        {
                            <span class="companion-element companion-element-@et.ToString().ToLower()">@et</span>
                        }
                    </span>
                </div>

                @* Battle record *@
                <div class="companion-stat-row">
                    <span class="companion-stat-label">Battles</span>
                    <span class="companion-battle-record">
                        <span class="record-win">@Companion.BattleWins W</span>
                        <span class="record-loss">@Companion.BattleLosses L</span>
                    </span>
                </div>

                @* ── Stat grid ── *@
                @if (Companion.AvailableStatPoints > 0)
                {
                    <div class="companion-stat-points-row">
                        @Companion.AvailableStatPoints stat point@(Companion.AvailableStatPoints != 1 ? "s" : "") available
                    </div>
                }

                @if (_statError != null)
                {
                    <div class="companion-moves-error">@_statError</div>
                }

                <div class="companion-stat-grid">
                    @foreach (var (key, label, fmt) in StatRows)
                    {
                        int allocated = Companion.GetAllocated(key);
                        <div class="companion-stat-item">
                            <span class="companion-stat-label">@label</span>
                            <span class="companion-stat-value">@fmt(allocated)</span>
                            @if (Companion.AvailableStatPoints > 0)
                            {
                                string k = key;
                                <button class="companion-alloc-btn" @onclick="() => AllocateStat(k)">+</button>
                            }
                            else
                            {
                                <span class="companion-alloc-spacer"></span>
                            }
                        </div>
                    }
                </div>

                @* ── Items section ── *@
                @{
                    bool hasCore  = PlayerInventory.TryGetValue("ElementalCore",  out int coreQty)  && coreQty  > 0;
                    bool hasStone = PlayerInventory.TryGetValue("EvolutionStone", out int stoneQty) && stoneQty > 0;
                    bool canCore  = hasCore  && Companion.ElementTypes.Count < 2;
                    bool canEvolve= hasStone && Companion.Tier < CompanionTier.T3;
                }
                @if (canCore || canEvolve)
                {
                    <div class="companion-items-section">
                        <div class="companion-items-label">Items</div>
                        @if (canCore)
                        {
                            @if (!_showCorePicker)
                            {
                                <button class="companion-item-btn core-btn" @onclick="() => _showCorePicker = true">
                                    Use Elemental Core (@coreQty)
                                </button>
                            }
                            else
                            {
                                <div class="companion-core-picker">
                                    <span class="companion-core-picker-label">Choose element:</span>
                                    @foreach (var el in AllElements.Where(e => !EffectiveElementTypes.Contains(e)))
                                    {
                                        DamageType el2 = el;
                                        <button class="companion-element companion-element-@el2.ToString().ToLower() companion-core-choice"
                                                @onclick="() => UseElementalCore(el2)">
                                            @el2
                                        </button>
                                    }
                                    <button class="companion-item-btn" @onclick="() => _showCorePicker = false">Cancel</button>
                                </div>
                            }
                        }
                        @if (canEvolve)
                        {
                            <button class="companion-item-btn evolve-btn" @onclick="UseEvolutionStone">
                                Use Evolution Stone (@stoneQty) → @(Companion.Tier + 1)
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="modal-actions">
                <button class="companion-release-btn" @onclick="HandleRelease">Release</button>
                <button @onclick="HandleCancel">Close</button>
            </div>
        }
        else if (_tab == "moves")
        {
            var effectiveTypes = EffectiveElementTypes;
            var eligibleMoves  = MoveProvider.GetEligibleFor(effectiveTypes);
            int maxMoves       = TierRegistry.Get(Companion.Tier).MaxMoves;

            <div class="companion-moves-body">
                <p class="companion-moves-hint">Select up to @maxMoves moves. Click a slot to change it.</p>

                @if (_moveError != null)
                {
                    <div class="companion-moves-error">@_moveError</div>
                }

                <div class="companion-move-slots">
                    @for (int slot = 0; slot < maxMoves; slot++)
                    {
                        int s = slot;
                        bool hasMove = s < _editMoveIds.Count;
                        bool isOpen  = _pickerSlot == s;
                        var slotMove = hasMove ? MoveProvider.GetById(_editMoveIds[s]) : null;

                        <div class="companion-move-slot @(isOpen ? "open" : "") @(!hasMove ? "empty" : "")"
                             @onclick="() => TogglePicker(s)">
                            @if (slotMove != null)
                            {
                                <div class="companion-move-slot-header">
                                    <span class="companion-move-name">@slotMove.Name</span>
                                    @if (slotMove.Kind == CompanionMoveKind.Attack || slotMove.Kind == CompanionMoveKind.StatusAttack)
                                    {
                                        <span class="companion-element companion-element-@slotMove.DamageType.ToString().ToLower()">@slotMove.DamageType</span>
                                        <span class="companion-move-power">~@((int)(EffectiveAttack * slotMove.Power)) dmg</span>
                                        @if (slotMove.HitsAll) { <span class="companion-move-aoe">AOE</span> }
                                        @if (slotMove.Kind == CompanionMoveKind.StatusAttack)
                                        {
                                            <span class="companion-move-status">@slotMove.InflictStatus @((int)(slotMove.StatusChance * 100))%</span>
                                        }
                                    }
                                    else if (slotMove.Kind == CompanionMoveKind.PlayerBuff)
                                    {
                                        <span class="companion-move-kind buff">Buff</span>
                                        <span class="companion-move-power">@FormatEffect(slotMove)</span>
                                    }
                                    else
                                    {
                                        <span class="companion-move-kind debuff">Debuff</span>
                                        <span class="companion-move-power">@FormatEffect(slotMove)</span>
                                    }
                                    <button class="companion-move-remove" @onclick:stopPropagation
                                            @onclick="() => RemoveMove(s)">×</button>
                                </div>
                                @if (!string.IsNullOrEmpty(slotMove.Description))
                                {
                                    <span class="companion-move-desc">@slotMove.Description</span>
                                }
                            }
                            else
                            {
                                <span class="companion-move-slot-empty">+ Add move</span>
                            }
                        </div>

                        @if (isOpen)
                        {
                            <div class="companion-move-picker">
                                @foreach (var group in eligibleMoves.GroupBy(m => m.Kind).OrderBy(g => g.Key))
                                {
                                    string kindLabel = group.Key switch
                                    {
                                        CompanionMoveKind.Attack       => "Attacks",
                                        CompanionMoveKind.StatusAttack => "Status Attacks",
                                        CompanionMoveKind.PlayerBuff   => "Buffs",
                                        _                              => "Debuffs",
                                    };
                                    <div class="companion-picker-group">
                                        <div class="companion-picker-group-label">@kindLabel</div>
                                        @foreach (var m in group)
                                        {
                                            bool inUse = _editMoveIds.Contains(m.Id);
                                            <div class="companion-picker-option @(inUse ? "in-use" : "")"
                                                 @onclick="() => { if (!inUse) AssignMove(s, m.Id); }">
                                                <div class="companion-picker-option-header">
                                                    <span class="companion-move-name">@m.Name</span>
                                                    @if (m.Kind is CompanionMoveKind.Attack or CompanionMoveKind.StatusAttack)
                                                    {
                                                        <span class="companion-element companion-element-@m.DamageType.ToString().ToLower()">@m.DamageType</span>
                                                        <span class="companion-move-power">~@((int)(EffectiveAttack * m.Power)) dmg</span>
                                                        @if (m.Kind == CompanionMoveKind.StatusAttack)
                                                        {
                                                            <span class="companion-move-status">@m.InflictStatus @((int)(m.StatusChance * 100))%</span>
                                                        }
                                                    }
                                                    else if (m.Kind == CompanionMoveKind.PlayerBuff)
                                                    {
                                                        <span class="companion-move-kind buff">Buff</span>
                                                        <span class="companion-move-power">@FormatEffect(m)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="companion-move-kind debuff">Debuff</span>
                                                        <span class="companion-move-power">@FormatEffect(m)</span>
                                                    }
                                                    @if (m.HitsAll) { <span class="companion-move-aoe">AOE</span> }
                                                </div>
                                                @if (!string.IsNullOrEmpty(m.Description))
                                                {
                                                    <span class="companion-move-desc">@m.Description</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="modal-actions">
                <button @onclick="HandleCancel">Cancel</button>
                <button class="btn-primary" @onclick="HandleSaveMoves">Save Moves</button>
            </div>
        }
        else
        {
            int gridCols = TierRegistry.Get(Companion.Tier).GridCols;
            int cellPx   = Companion.Tier == CompanionTier.T1 ? 24 : Companion.Tier == CompanionTier.T2 ? 20 : 16;
            string gridSizeClass = Companion.Tier == CompanionTier.T1 ? "" : Companion.Tier == CompanionTier.T2 ? "medium-grid" : "large-grid";
            <div class="sprite-editor-body"
                 @onmouseleave="() => _isPainting = false">
                <div class="sprite-grid-wrap">
                    <div class="sprite-grid @(gridSizeClass)"
                         @onmouseup="() => _isPainting = false">
                        @for (int i = 0; i < _pixels.Length; i++)
                        {
                            int idx = i;
                            string fill = string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : _pixels[idx];
                            <div class="sprite-cell @(string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : "")"
                                 style="background: @fill;"
                                 @onmousedown="(e) => HandleMouseDown(idx, e)"
                                 @onmouseenter="() => { if (_isPainting) ApplyPaint(idx); }"
                                 @oncontextmenu:preventDefault>
                            </div>
                        }
                    </div>
                </div>

                <div class="sprite-preview-wrap">
                    <div class="sprite-preview-label">Preview</div>
                    <svg viewBox="0 0 @gridCols @gridCols" width="64" height="64" class="sprite-preview-svg">
                        @for (int i = 0; i < _pixels.Length; i++)
                        {
                            if (!string.IsNullOrEmpty(_pixels[i]))
                            {
                                int px = i % gridCols, py = i / gridCols;
                                <rect x="@px" y="@py" width="1" height="1" fill="@_pixels[i]" />
                            }
                        }
                    </svg>
                </div>
            </div>

            <div class="sprite-editor-tools">
                <label class="sprite-tool-label companion-nickname-label">
                    Name
                    <input class="companion-nickname-input" maxlength="20"
                           @bind="_nickname" @bind:event="oninput" />
                </label>
                <label class="sprite-tool-label">
                    Color
                    <input type="color" class="sprite-color-input" value="@_hexColor" @onchange="HandleColorChange" />
                </label>
                <label class="sprite-tool-label">
                    Opacity
                    <input type="range" min="0" max="255" value="@_alpha" class="sprite-alpha-slider"
                           @onchange="HandleAlphaChange" />
                    <span class="sprite-alpha-value">@((int)Math.Round(_alpha / 255.0 * 100))%</span>
                </label>
                <button class="sprite-tool-btn @(_erasing ? "active" : "")"
                        @onclick="() => { _erasing = !_erasing; }">
                    @(_erasing ? "✏ Paint" : "⬜ Erase")
                </button>
                <button class="sprite-tool-btn" @onclick="ApplyDefault">Default</button>
                <button class="sprite-tool-btn" @onclick="ClearAll">Clear All</button>
            </div>

            <div class="modal-actions">
                <button @onclick="HandleCancel">Cancel</button>
                <button class="btn-primary" @onclick="HandleSave">Save Sprite</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PlayerCompanion Companion { get; set; } = null!;
    [Parameter] public Dictionary<string, int> PlayerInventory { get; set; } = [];
    [Parameter] public EventCallback<string[]> OnSaveSprite { get; set; }
    [Parameter] public EventCallback<string> OnSaveNickname { get; set; }
    [Parameter] public EventCallback<List<string>> OnSaveMoves { get; set; }
    [Parameter] public EventCallback<string> OnAllocateStat { get; set; }
    [Parameter] public EventCallback<DamageType> OnUseElementalCore { get; set; }
    [Parameter] public EventCallback OnUseEvolutionStone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRelease { get; set; }

    private string _tab = "stats";
    private string _nickname = "";
    private string[] _pixels = [];
    private string _hexColor = "#ffffff";
    private double _alpha = 255;
    private bool _erasing;
    private bool _isPainting;
    private bool _paintingAsErase;
    private string? _moveError;
    private string? _statError;
    private bool _showCorePicker;

    private List<string> _editMoveIds = [];
    private int _pickerSlot = -1;

    private static readonly DamageType[] AllElements =
    [
        DamageType.Fire, DamageType.Frost, DamageType.Storm,
        DamageType.Nature, DamageType.Dark,
    ];

    private IReadOnlyList<DamageType> EffectiveElementTypes => Companion.ElementTypes;

    private string TemperamentHint => Companion.Temperament switch
    {
        CompanionTemperament.Bold     => "+ATK, -DEF",
        CompanionTemperament.Timid    => "+DEF, -ATK",
        CompanionTemperament.Reckless => "+ATK, +SPD, -DEF",
        CompanionTemperament.Careful  => "+DEF, +RES, -SPD",
        CompanionTemperament.Cunning  => "+FOC, +SPD, -VIT",
        CompanionTemperament.Stoic    => "+RES, +DEF, -FOC",
        CompanionTemperament.Playful  => "+SPD, +FOC, -ATK",
        CompanionTemperament.Fierce   => "+ATK×2, -RES, -DEF",
        _ => "",
    };

    private int GetStat(string key) => Companion.Stats.GetValueOrDefault(key);

    // (statKey, display label, format function for computed display value)
    private TemperamentDefinition TempDef =>
        TemperamentRegistry.Get(Companion.Temperament);

    private IEnumerable<(string Key, string Label, Func<int, string> Fmt)> StatRows =>
    [
        ("ATK", "ATK",  alloc => $"{(int)(GetStat("ATK") * 3f + alloc + TempDef.AtkBonus)}"),
        ("DEF", "DEF",  alloc => $"{Math.Max(0, GetStat("DEF") + alloc + TempDef.DefBonus)}"),
        ("VIT", "HP",   alloc => $"{80 + Math.Max(0, GetStat("VIT") + alloc + TempDef.VitBonus) * 10}"),
        ("SPD", "SPD",  alloc => $"{GetStat("SPD") + alloc + TempDef.SpdBonus}"),
        ("FOC", "CRIT", alloc => $"{(int)Math.Clamp((0.05f + (GetStat("FOC") + alloc + TempDef.FocBonus) * 0.025f) * 100, 5, 45)}%"),
        ("RES", "RES",  alloc => $"{(int)Math.Clamp((GetStat("RES") + alloc + TempDef.ResBonus) * 6, 0, 55)}%"),
    ];

    private int EffectiveAttack =>
        (int)(GetStat("ATK") * 3f + Companion.GetAllocated("ATK") + TempDef.AtkBonus);

    protected override void OnInitialized()
    {
        _nickname    = Companion.Nickname;
        _editMoveIds = [.. Companion.MoveIds];
        ResetSprite();
    }

    private void ResetSprite()
    {
        int size = TierRegistry.Get(Companion.Tier).SpriteSize;
        _pixels  = new string[size];
        var src  = Companion.SpritePixels;
        for (int i = 0; i < size && i < src.Length; i++)
            _pixels[i] = src[i] ?? "";
        _hexColor = ElementDefaultColor();
    }

    private string ElementDefaultColor() => Companion.ElementTypes.FirstOrDefault() switch
    {
        DamageType.Fire    => "#e05020",
        DamageType.Frost   => "#4090e0",
        DamageType.Storm   => "#e0c020",
        DamageType.Nature  => "#40c040",
        DamageType.Dark    => "#8030c0",
        _                  => "#a0a0a0",
    };

    private void TogglePicker(int slot) =>
        _pickerSlot = _pickerSlot == slot ? -1 : slot;

    private void AssignMove(int slot, string moveId)
    {
        while (_editMoveIds.Count <= slot) _editMoveIds.Add("");
        _editMoveIds[slot] = moveId;
        _pickerSlot = -1;
    }

    private void RemoveMove(int slot)
    {
        if (slot < _editMoveIds.Count) _editMoveIds.RemoveAt(slot);
        _pickerSlot = -1;
    }

    private async Task HandleSaveMoves()
    {
        _moveError = null;
        var cleanIds = _editMoveIds.Where(id => !string.IsNullOrEmpty(id)).ToList();
        await OnSaveMoves.InvokeAsync(cleanIds);
    }

    private async Task AllocateStat(string stat)
    {
        _statError = null;
        await OnAllocateStat.InvokeAsync(stat);
    }

    private async Task UseElementalCore(DamageType element)
    {
        _showCorePicker = false;
        await OnUseElementalCore.InvokeAsync(element);
    }

    private async Task UseEvolutionStone()
    {
        await OnUseEvolutionStone.InvokeAsync();
        ResetSprite(); // sprite size may have changed
    }

    private void HandleMouseDown(int idx, MouseEventArgs e)
    {
        _isPainting = true;
        _paintingAsErase = e.Button == 2;
        ApplyPaint(idx);
        StateHasChanged();
    }

    private void ApplyPaint(int idx)
    {
        _pixels[idx] = (_erasing || _paintingAsErase) ? "" : BuildColor();
        StateHasChanged();
    }

    private void ApplyDefault()
    {
        int size = TierRegistry.Get(Companion.Tier).SpriteSize;
        _pixels  = new string[size];
        var primaryElement = Companion.ElementTypes.FirstOrDefault();
        var src = DefProvider.GetAll()
            .FirstOrDefault(d => d.ElementTypes.Contains(primaryElement))
            ?.DefaultSprite ?? [];
        for (int i = 0; i < size && i < src.Length; i++)
            _pixels[i] = src[i] ?? "";
    }

    private void ClearAll()
    {
        int size = TierRegistry.Get(Companion.Tier).SpriteSize;
        _pixels  = new string[size];
    }

    private string BuildColor()
    {
        int a = (int)Math.Clamp(Math.Round(_alpha), 0, 255);
        return _hexColor + a.ToString("x2");
    }

    private void HandleColorChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val)) _hexColor = val;
        _erasing = false;
    }

    private void HandleAlphaChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double v)) _alpha = v;
    }

    private async Task HandleSave()
    {
        var trimmed = _nickname.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != Companion.Nickname)
            await OnSaveNickname.InvokeAsync(trimmed);
        await OnSaveSprite.InvokeAsync([.. _pixels]);
    }

    private static string FormatEffect(CompanionMove move)
    {
        if (move.Kind == CompanionMoveKind.PlayerBuff)
        {
            if (move.EffectStat == null)
                return $"Heal +{(int)move.EffectValue} HP";
            string statLabel = move.EffectStat == ModifierStat.DodgeChance
                ? $"Dodge +{move.EffectValue * 100:F0}%"
                : $"{move.EffectStat} +{(int)move.EffectValue}";
            return $"{statLabel} · {move.EffectTurns}t";
        }
        else
        {
            string statLabel = move.EffectStat == ModifierStat.DodgeChance
                ? $"Dodge {move.EffectValue * 100:F0}%"
                : $"{move.EffectStat} {(int)move.EffectValue}";
            return $"{statLabel} · {move.EffectTurns}t";
        }
    }

    private async Task HandleCancel() => await OnCancel.InvokeAsync();
    private async Task HandleRelease() => await OnRelease.InvokeAsync();
}
