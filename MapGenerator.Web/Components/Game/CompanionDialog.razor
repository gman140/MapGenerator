@using MapGenerator.Combat.Models
@using MapGenerator.Domain.Models
@using MapGenerator.Combat.Enums
@using MapGenerator.Web.Services

<div class="modal-overlay" @onclick="HandleCancel">
    <div class="companion-dialog" @onclick:stopPropagation
         @onmouseup="() => _isPainting = false"
         @oncontextmenu:preventDefault>

        <div class="companion-dialog-titlebar">
            <span class="companion-emoji">@Definition.Emoji</span>
            <span class="companion-dialog-name">@Companion.Nickname</span>
            @if (Companion.Nickname != Definition.Name)
            {
                <span class="companion-dialog-species">(@Definition.Name)</span>
            }
        </div>

        <div class="sprite-editor-tabs">
            <button class="sprite-tab @(_tab == "stats" ? "active" : "")" @onclick='() => _tab = "stats"'>Stats</button>
            <button class="sprite-tab @(_tab == "sprite" ? "active" : "")" @onclick='() => _tab = "sprite"'>Sprite</button>
        </div>

        @if (_tab == "stats")
        {
            <div class="companion-stats-body">
                <p class="companion-desc">@Definition.Description</p>

                <div class="companion-stat-row">
                    <span class="companion-stat-label">Element</span>
                    <span class="companion-element companion-element-@Definition.ElementType.ToString().ToLower()">
                        @Definition.ElementType
                    </span>
                </div>
                <div class="companion-stat-row">
                    <span class="companion-stat-label">Base Attack</span>
                    <strong>@Definition.BaseAttack</strong>
                </div>

                <div class="companion-moves-section">
                    <div class="companion-moves-header">Moves</div>
                    @foreach (var moveId in Companion.MoveIds)
                    {
                        var move = Definition.Moves.FirstOrDefault(m => m.Id == moveId);
                        if (move != null)
                        {
                            <div class="companion-move-row">
                                <span class="companion-move-name">@move.Name</span>
                                @if (move.Kind == CompanionMoveKind.Attack) {
                                    <span class="companion-element companion-element-@move.DamageType.ToString().ToLower()">@move.DamageType</span>
                                }
                                <span class="companion-move-power">~@((int)(Definition.BaseAttack * move.Power)) dmg</span>
                                @if (move.HitsAll) { <span class="companion-move-aoe">AOE</span> }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="modal-actions">
                <button class="companion-release-btn" @onclick="HandleRelease">Release Companion</button>
                <button @onclick="HandleCancel">Close</button>
            </div>
        }
        else
        {
            <div class="sprite-editor-body"
                 @onmouseleave="() => _isPainting = false">
                <div class="sprite-grid-wrap">
                    <div class="sprite-grid"
                         @onmouseup="() => _isPainting = false">
                        @for (int i = 0; i < 256; i++)
                        {
                            int idx = i;
                            string fill = string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : _pixels[idx];
                            <div class="sprite-cell @(string.IsNullOrEmpty(_pixels[idx]) ? "transparent" : "")"
                                 style="background: @fill"
                                 @onmousedown="(e) => HandleMouseDown(idx, e)"
                                 @onmouseenter="() => { if (_isPainting) ApplyPaint(idx); }"
                                 @oncontextmenu:preventDefault>
                            </div>
                        }
                    </div>
                </div>

                <div class="sprite-preview-wrap">
                    <div class="sprite-preview-label">Preview</div>
                    <svg width="64" height="64" class="sprite-preview-svg">
                        @for (int i = 0; i < 256; i++)
                        {
                            if (!string.IsNullOrEmpty(_pixels[i]))
                            {
                                int px = i % 16, py = i / 16;
                                <rect x="@(px * 4)" y="@(py * 4)" width="4" height="4" fill="@_pixels[i]" />
                            }
                        }
                    </svg>
                </div>
            </div>

            <div class="sprite-editor-tools">
                <label class="sprite-tool-label companion-nickname-label">
                    Name
                    <input class="companion-nickname-input" maxlength="20"
                           @bind="_nickname" @bind:event="oninput" />
                </label>
                <label class="sprite-tool-label">
                    Color
                    <input type="color" class="sprite-color-input" value="@_hexColor" @onchange="HandleColorChange" />
                </label>
                <label class="sprite-tool-label">
                    Opacity
                    <input type="range" min="0" max="255" value="@_alpha" class="sprite-alpha-slider"
                           @onchange="HandleAlphaChange" />
                    <span class="sprite-alpha-value">@((int)Math.Round(_alpha / 255.0 * 100))%</span>
                </label>
                <button class="sprite-tool-btn @(_erasing ? "active" : "")"
                        @onclick="() => { _erasing = !_erasing; }">
                    @(_erasing ? "✏ Paint" : "⬜ Erase")
                </button>
                <button class="sprite-tool-btn" @onclick="ApplyDefault">Default</button>
                <button class="sprite-tool-btn" @onclick="ClearAll">Clear All</button>
            </div>

            <div class="modal-actions">
                <button @onclick="HandleCancel">Cancel</button>
                <button class="btn-primary" @onclick="HandleSave">Save Sprite</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PlayerCompanion Companion { get; set; } = null!;
    [Parameter, EditorRequired] public CompanionDefinition Definition { get; set; } = null!;
    [Parameter] public EventCallback<string[]> OnSaveSprite { get; set; }
    [Parameter] public EventCallback<string> OnSaveNickname { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnRelease { get; set; }

    private string _tab = "stats";
    private string _nickname = "";
    private string[] _pixels = new string[256];
    private string _hexColor = "#ffffff";
    private double _alpha = 255;
    private bool _erasing;
    private bool _isPainting;
    private bool _paintingAsErase;

    protected override void OnInitialized()
    {
        _nickname = Companion.Nickname;
        ResetSprite();
    }

    private void ResetSprite()
    {
        _pixels = new string[256];
        var src = Companion.SpritePixels;
        for (int i = 0; i < 256 && i < src.Length; i++)
            _pixels[i] = src[i] ?? "";
        _hexColor = ElementDefaultColor();
    }

    private string ElementDefaultColor() => Definition.ElementType.ToString() switch
    {
        "Fire"    => "#e05020",
        "Frost"   => "#4090e0",
        "Storm"   => "#e0c020",
        "Nature"  => "#40c040",
        "Dark"    => "#8030c0",
        _         => "#a0a0a0",
    };

    private void HandleMouseDown(int idx, MouseEventArgs e)
    {
        _isPainting = true;
        _paintingAsErase = e.Button == 2;
        ApplyPaint(idx);
        StateHasChanged();
    }

    private void ApplyPaint(int idx)
    {
        _pixels[idx] = (_erasing || _paintingAsErase) ? "" : BuildColor();
        StateHasChanged();
    }

    private void ApplyDefault()
    {
        _pixels = new string[256];
        var src = Definition.DefaultSprite;
        for (int i = 0; i < 256 && i < src.Length; i++)
            _pixels[i] = src[i] ?? "";
    }

    private void ClearAll()
    {
        for (int i = 0; i < 256; i++) _pixels[i] = "";
    }

    private string BuildColor()
    {
        int a = (int)Math.Clamp(Math.Round(_alpha), 0, 255);
        return _hexColor + a.ToString("x2");
    }

    private void HandleColorChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val)) _hexColor = val;
        _erasing = false;
    }

    private void HandleAlphaChange(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double v)) _alpha = v;
    }

    private async Task HandleSave()
    {
        var trimmed = _nickname.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed != Companion.Nickname)
            await OnSaveNickname.InvokeAsync(trimmed);
        await OnSaveSprite.InvokeAsync([.. _pixels]);
    }

    private async Task HandleCancel() => await OnCancel.InvokeAsync();

    private async Task HandleRelease() => await OnRelease.InvokeAsync();
}
