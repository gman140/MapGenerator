@using MapGenerator.Combat.Models
@using MapGenerator.Domain.Models

<div class="companion-panel">
    <div class="companion-header">
        <button class="sprite-edit-btn companion-sprite-btn" title="View stats / edit sprite"
                @onclick="async () => await OnOpenDialog.InvokeAsync()">
            @if (Companion.SpritePixels.Any(p => !string.IsNullOrEmpty(p)))
            {
                <svg width="32" height="32" class="sprite-edit-preview">
                    @for (int i = 0; i < 256 && i < Companion.SpritePixels.Length; i++)
                    {
                        if (!string.IsNullOrEmpty(Companion.SpritePixels[i]))
                        {
                            int px = i % 16, py = i / 16;
                            <rect x="@(px * 2)" y="@(py * 2)" width="2" height="2" fill="@Companion.SpritePixels[i]" />
                        }
                    }
                </svg>
            }
            else
            {
                <span class="companion-emoji-placeholder">@Definition.Emoji</span>
            }
        </button>
        <span class="companion-name">@Companion.Nickname</span>
        <span class="companion-element companion-element-@Definition.ElementType.ToString().ToLower()">
            @Definition.ElementType
        </span>
    </div>

    @if (Companion.Nickname != Definition.Name)
    {
        <div class="companion-species">@Definition.Name</div>
    }

</div>

@code {
    [Parameter, EditorRequired] public PlayerCompanion Companion { get; set; } = null!;
    [Parameter, EditorRequired] public CompanionDefinition Definition { get; set; } = null!;
    [Parameter] public EventCallback OnOpenDialog { get; set; }
}
