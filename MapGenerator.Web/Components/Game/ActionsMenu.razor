@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Models
@using static MapGenerator.Application.Services.HungerService
@implements IDisposable

<div class="actions-menu">
    @if (!Player.IsInCombat)
    {
        <button class="action-item" @onclick="HandleInvestigate">🔍 Investigate</button>
        @if (!IsInDungeon)
        {
            <button class="action-item" @onclick="HandleLeaveNote">📝 Leave a Note</button>
            <button class="action-item" @onclick="HandlePlantSign">🪧 Plant a Sign</button>
        }
        <button class="action-item" @onclick="HandleGather"
                disabled="@(!TileHasResources || GatherOnCooldown)">
            ⛏ Gather
            @if (GatherOnCooldown)
            {
                <span class="action-cooldown">@_gatherCooldownText</span>
            }
            else if (!TileHasResources)
            {
                <span class="action-cooldown">nothing here</span>
            }
        </button>
        @if (!IsInDungeon)
        {
            <button class="action-item" @onclick="LayEgg" disabled="@EggOnCooldown">
                🥚 Lay Egg
                @if (EggOnCooldown)
                {
                    <span class="action-cooldown">@_eggCooldownText</span>
                }
            </button>
<button class="action-item" @onclick="HandleDance" disabled="@DanceOnCooldown">
                💃 Dance
                @if (DanceOnCooldown)
                {
                    <span class="action-cooldown">@_danceCooldownText</span>
                }
            </button>
        }
        @if (IsOnDungeonEntrance && !IsInDungeon)
        {
            <button class="action-item dungeon-enter-btn" @onclick="HandleEnterDungeon">
                🕳️ Enter Dungeon
            </button>
        }
        @if (IsInDungeon && IsOnStaircaseDown)
        {
            <button class="action-item dungeon-stair-btn" @onclick="HandleUseStaircase">
                ⬇️ Descend
            </button>
        }
        @if (IsInDungeon && IsOnStaircaseUp)
        {
            <button class="action-item dungeon-stair-btn" @onclick="HandleUseStaircase">
                @(IsOnFloorOne ? "⬆️ Exit Dungeon" : "⬆️ Ascend")
            </button>
        }
        @if (IsInDungeon && HasRope)
        {
            <button class="action-item dungeon-rope-btn" @onclick="HandleUseRope">
                🪢 Use Rope <span class="action-cooldown">(exit)</span>
            </button>
        }
        @if (!IsInDungeon && TileHasEgg && !HasCompanion)
        {
            <button class="action-item companion-hatch-btn" @onclick="HandleHatch">
                🐣 Hatch Companion
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public EventCallback OnLayEgg { get; set; }
    [Parameter] public EventCallback OnInvestigate { get; set; }
    [Parameter] public EventCallback OnLeaveNote { get; set; }
    [Parameter] public EventCallback OnPlantSign { get; set; }
    [Parameter] public EventCallback OnGather { get; set; }
[Parameter] public EventCallback OnDance { get; set; }
    [Parameter] public EventCallback OnEnterDungeon { get; set; }
    [Parameter] public EventCallback OnUseRope { get; set; }
    [Parameter] public EventCallback OnUseStaircase { get; set; }
    [Parameter] public DateTime? LastEggLaidAt { get; set; }
    [Parameter] public DateTime? LastDancedAt { get; set; }
    [Parameter] public bool CooldownBypassed { get; set; }
    [Parameter] public long GatherCooldownUntil { get; set; }
    [Parameter] public bool TileHasResources { get; set; }
    [Parameter] public bool IsOnDungeonEntrance { get; set; }
    [Parameter] public bool IsInDungeon { get; set; }
    [Parameter] public bool HasRope { get; set; }
    [Parameter] public bool IsOnStaircaseUp { get; set; }
    [Parameter] public bool IsOnStaircaseDown { get; set; }
    [Parameter] public bool IsOnFloorOne { get; set; }
    [Parameter] public bool TileHasEgg { get; set; }
    [Parameter] public bool HasCompanion { get; set; }
    [Parameter] public EventCallback OnHatch { get; set; }

    private TimeSpan EffectiveEggCooldown
    {
        get
        {
            double hungerMult = GetCooldownMultiplier(Player.Satiety);
            double buffMult   = Player.ActiveBuffs.FirstOrDefault(b => b.Type == BuffType.CooldownReduction)?.Magnitude ?? 1.0;
            return TimeSpan.FromMinutes(1) * (hungerMult * buffMult);
        }
    }

    private bool EggOnCooldown   => !CooldownBypassed && LastEggLaidAt.HasValue && (DateTime.UtcNow - LastEggLaidAt.Value) < EffectiveEggCooldown;
    private bool DanceOnCooldown => !CooldownBypassed && LastDancedAt.HasValue  && (DateTime.UtcNow - LastDancedAt.Value).TotalMinutes  < 1;
    private bool GatherOnCooldown => !CooldownBypassed && DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() < GatherCooldownUntil;
    private string _eggCooldownText   = "";
    private string _danceCooldownText = "";
    private string _gatherCooldownText = "";
    private System.Threading.Timer? _timer;

    protected override void OnParametersSet()
    {
        bool needsTimer = EggOnCooldown || DanceOnCooldown || GatherOnCooldown;
        if (needsTimer)
        {
            UpdateCooldownTexts();
            _timer ??= new System.Threading.Timer(Tick, null, 100, 100);
        }
        else
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private void Tick(object? _)
    {
        UpdateCooldownTexts();
        if (!EggOnCooldown && !DanceOnCooldown && !GatherOnCooldown) { _timer?.Dispose(); _timer = null; }
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCooldownTexts()
    {
        if (LastEggLaidAt.HasValue)
        {
            var remaining = EffectiveEggCooldown - (DateTime.UtcNow - LastEggLaidAt.Value);
            _eggCooldownText = remaining > TimeSpan.Zero ? $"({remaining.TotalSeconds:F0}s)" : "";
        }

        if (LastDancedAt.HasValue)
        {
            var remaining = TimeSpan.FromMinutes(1) - (DateTime.UtcNow - LastDancedAt.Value);
            _danceCooldownText = remaining > TimeSpan.Zero ? $"({remaining.TotalSeconds:F0}s)" : "";
        }

        long now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        if (GatherCooldownUntil > now)
        {
            double secs = (GatherCooldownUntil - now) / 1000.0;
            _gatherCooldownText = $"({secs:F1}s)";
        }
        else
        {
            _gatherCooldownText = "";
        }
    }

    private async Task LayEgg()             { await OnLayEgg.InvokeAsync(); }
    private async Task HandleInvestigate()  { await OnInvestigate.InvokeAsync(); }
    private async Task HandleLeaveNote()    { await OnLeaveNote.InvokeAsync(); }
    private async Task HandlePlantSign()    { await OnPlantSign.InvokeAsync(); }
    private async Task HandleGather()       { await OnGather.InvokeAsync(); }
private async Task HandleDance()        { await OnDance.InvokeAsync(); }
    private async Task HandleEnterDungeon()  { await OnEnterDungeon.InvokeAsync(); }
    private async Task HandleUseRope()       { await OnUseRope.InvokeAsync(); }
    private async Task HandleUseStaircase()  { await OnUseStaircase.InvokeAsync(); }
    private async Task HandleHatch()         { await OnHatch.InvokeAsync(); }

    public void Dispose() => _timer?.Dispose();
}
