@using MapGenerator.Combat.Enums
@using MapGenerator.Combat.Models

<div class="combat-view">
    @if (EndResult != null)
    {
        <div class="combat-end-screen">
            @if (EndResult.Victory && !EndResult.Fled)
            {
                <div class="combat-end-title victory">Victory!</div>
            }
            else if (EndResult.Fled)
            {
                <div class="combat-end-title fled">Escaped!</div>
            }
            else
            {
                <div class="combat-end-title defeat">Defeated</div>
            }

            @if (EndResult.PlayerDied)
            {
                @if (IsAdmin)
                {
                    <p class="combat-end-msg">You fell in battle, but your admin privileges spare you. You're respawned safely.</p>
                }
                else
                {
                    <p class="combat-end-msg">You have been slain. All your belongings are lost.</p>
                }
            }
            else if (EndResult.Fled)
            {
                <p class="combat-end-msg">You slip away into the dark. Your belongings are safe.</p>
            }

            @if (EndResult.LootGained.Count > 0)
            {
                <div class="combat-end-loot">
                    <p class="combat-end-loot-label">Loot gained:</p>
                    @foreach (var (id, qty) in EndResult.LootGained)
                    {
                        <div class="combat-end-loot-item">@id <span class="combat-end-loot-qty">×@qty</span></div>
                    }
                </div>
            }

            <div class="combat-end-log">
                @foreach (var line in Session.Log.AsEnumerable().Reverse().Take(5))
                {
                    <div class="combat-log-line">@line</div>
                }
            </div>

            <button class="combat-end-btn" @onclick="() => OnConfirmEnd.InvokeAsync()">Continue</button>
        </div>
    }
    else
    {
        <div class="combat-hud">
            <span class="combat-context">@Session.ContextLabel — Turn @Session.TurnNumber</span>
        </div>

        <div class="combat-battlefield">
            <div class="combat-player-side">
                <svg width="120" height="120" class="combat-player-svg @(_playerShaking ? "combat-shake" : "") @(_shakingEnemyId != null ? "combat-strike" : "")">
                    <circle cx="60" cy="60" r="28" fill="@PlayerColor" stroke="#fff" stroke-width="3" />
                    <text x="60" y="65" text-anchor="middle" font-size="11" fill="#fff">YOU</text>
                </svg>
                <div class="combat-player-label">@PlayerName</div>
                @if (Session.PlayerDefending)
                {
                    <div class="combat-status-badge defend">🛡 Defending</div>
                }
                @if (Session.PlayerDodging)
                {
                    <div class="combat-status-badge dodge">🌀 Dodging</div>
                }
            </div>

            <div class="combat-enemy-side">
                @foreach (var enemy in Session.Enemies.Where(e => e.CurrentHp > 0 && !e.HasFled))
                {
                    bool targeted = _targetEnemyId == enemy.InstanceId;
                    <div class="combat-enemy @(targeted ? "targeted" : "")"
                         @onclick="() => SelectTarget(enemy.InstanceId)">
                        <svg width="100" height="100" class="@(_shakingEnemyId == enemy.InstanceId ? "combat-shake" : "") @(_playerShaking ? "combat-strike-enemy" : "")">
                            @RenderEnemyShape(enemy.DefinitionId, targeted)
                        </svg>
                        <div class="combat-enemy-name">@enemy.Name</div>
                        <div class="combat-enemy-hp">
                            <div class="combat-hp-bar">
                                <div class="combat-hp-fill" style="width: @(enemy.CurrentHp * 100 / enemy.MaxHp)%;"></div>
                            </div>
                            <span>@enemy.CurrentHp / @enemy.MaxHp</span>
                        </div>
                    </div>
                }
                @foreach (var enemy in Session.Enemies.Where(e => e.HasFled))
                {
                    <div class="combat-enemy fled">
                        <div class="combat-enemy-name">@enemy.Name <em>(fled)</em></div>
                    </div>
                }
            </div>
        </div>

        <div class="combat-player-stats">
            <div class="combat-stat-row">
                <span class="combat-stat-label">HP</span>
                <div class="combat-hp-bar wide">
                    <div class="combat-hp-fill" style="width: @(Session.PlayerHp * 100 / Session.PlayerMaxHp)%;"></div>
                </div>
                <span class="combat-stat-value">@Session.PlayerHp / @Session.PlayerMaxHp</span>
            </div>
            <div class="combat-stat-row">
                <span class="combat-stat-label">⚡</span>
                <div class="combat-stamina-bar wide">
                    <div class="combat-stamina-fill" style="width: @(Session.PlayerStamina * 100 / Session.PlayerMaxStamina)%;"></div>
                </div>
                <span class="combat-stat-value">@Session.PlayerStamina / @Session.PlayerMaxStamina</span>
            </div>
        </div>

        @if (Session.Phase == CombatPhase.PlayerTurn)
        {
            <div class="combat-actions">
                <button class="combat-btn attack" disabled="@(Session.PlayerStamina < 2 || CannotTakeAction())"
                        @onclick="() => TakeTurn(CombatActionType.Attack)">
                    ⚔ Attack <span class="cost">(2)</span>
                </button>
                <button class="combat-btn heavy" disabled="@(Session.PlayerStamina < 4 || CannotTakeAction())"
                        @onclick="() => TakeTurn(CombatActionType.HeavyAttack)">
                    🗡 Heavy <span class="cost">(4)</span>
                </button>
                <button class="combat-btn dodge" disabled="@(Session.PlayerStamina < 2 || CannotTakeAction())"
                        @onclick="() => TakeTurn(CombatActionType.Dodge)">
                    🌀 Dodge <span class="cost">(2)</span>
                </button>
                <button class="combat-btn defend" disabled="@CannotTakeAction()"
                        @onclick="() => TakeTurn(CombatActionType.Defend)">
                    🛡 Defend <span class="cost">(+2⚡)</span>
                </button>
                @if (HasHealingItems)
                {
                    <button class="combat-btn item" disabled="@(Session.PlayerStamina < 1 || CannotTakeAction())"
                            @onclick="() => _showItemPicker = !_showItemPicker">
                        🎒 Item <span class="cost">(1)</span>
                    </button>
                }
                <button class="combat-btn flee" disabled="@CannotTakeAction()"
                        @onclick="() => TakeTurn(CombatActionType.Flee)">
                    🏃 Flee
                </button>
            </div>

            @if (_showItemPicker && HasHealingItems)
            {
                <div class="combat-item-picker">
                    @foreach (var (id, qty) in HealingItems)
                    {
                        <button class="combat-item-btn" @onclick="() => UseItem(id)">
                            @id <span class="qty">×@qty</span>
                        </button>
                    }
                </div>
            }
        }

        <div class="combat-log">
            @{
                int displayCount = LogDisplayCount > 0 ? LogDisplayCount : Session.Log.Count;
            }
            @foreach (var line in Session.Log.Take(displayCount).AsEnumerable().Reverse().Take(8))
            {
                <div class="combat-log-line">@line</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CombatSession Session { get; set; } = null!;
    [Parameter, EditorRequired] public string PlayerColor { get; set; } = "#50a0f0";
    [Parameter, EditorRequired] public string PlayerName { get; set; } = "You";
    [Parameter, EditorRequired] public Dictionary<string, int> PlayerInventory { get; set; } = new();
    [Parameter, EditorRequired] public Dictionary<string, int> PlayerCraftedItems { get; set; } = new();
    [Parameter] public EventCallback<CombatAction> OnAction { get; set; }
    [Parameter] public CombatResult? EndResult { get; set; }
    [Parameter] public EventCallback OnConfirmEnd { get; set; }
    [Parameter] public bool IsAdmin { get; set; }
    [Parameter] public int LogDisplayCount { get; set; }  // 0 = show all

    private string? _targetEnemyId;
    private bool _showItemPicker;
    private bool _waitingForResult;
    private bool _enemyPhase;
    private string? _shakingEnemyId;
    private bool _playerShaking;

    private IEnumerable<(string Id, int Qty)> HealingItems =>
        PlayerInventory
            .Concat(PlayerCraftedItems)
            .GroupBy(kv => kv.Key)
            .Select(g => (g.Key, g.Sum(kv => kv.Value)))
            .Where(t => t.Item2 > 0);

    private bool HasHealingItems => HealingItems.Any();
    private bool CannotTakeAction() => Session.Phase == CombatPhase.PlayerTurn && _waitingForResult;

    private void SelectTarget(string instanceId)
    {
        _targetEnemyId = instanceId;
    }

    private async Task TakeTurn(CombatActionType type)
    {
        _showItemPicker = false;
        _waitingForResult = true;
        _enemyPhase = false;

        if (type is CombatActionType.Attack or CombatActionType.HeavyAttack)
            ShakeEnemy(GetTarget());

        var action = new CombatAction
        {
            Type = type,
            TargetEnemyId = GetTarget(),
        };
        await OnAction.InvokeAsync(action);
        _waitingForResult = false;
        _enemyPhase = false;
    }

    private async Task UseItem(string itemId)
    {
        _showItemPicker = false;
        _waitingForResult = true;
        _enemyPhase = false;
        var action = new CombatAction
        {
            Type   = CombatActionType.UseItem,
            ItemId = itemId,
        };
        await OnAction.InvokeAsync(action);
        _waitingForResult = false;
        _enemyPhase = false;
    }

    internal void SetEnemyPhase(bool active)
    {
        _enemyPhase = active;
        if (!active) ShakePlayer();
        StateHasChanged();
    }

    private void ShakeEnemy(string? instanceId)
    {
        _shakingEnemyId = instanceId;
        _ = ClearAfterAsync(380, () => { _shakingEnemyId = null; });
    }

    private void ShakePlayer()
    {
        _playerShaking = true;
        _ = ClearAfterAsync(380, () => { _playerShaking = false; });
    }

    private async Task ClearAfterAsync(int ms, Action clear)
    {
        await Task.Delay(ms);
        clear();
        await InvokeAsync(StateHasChanged);
    }

    private string? GetTarget()
    {
        var alive = Session.Enemies.Where(e => e.CurrentHp > 0 && !e.HasFled).ToList();
        if (alive.Count == 1) return alive[0].InstanceId;
        return _targetEnemyId;
    }

    private static RenderFragment RenderEnemyShape(string defId, bool targeted) => __builder =>
    {
        string stroke = targeted ? "#ffe066" : "#aaa";
        float sw = targeted ? 3f : 1.5f;

        switch (defId)
        {
            case "Slime":
                __builder.OpenElement(0, "ellipse");
                __builder.AddAttribute(1, "cx", "50"); __builder.AddAttribute(2, "cy", "58");
                __builder.AddAttribute(3, "rx", "28"); __builder.AddAttribute(4, "ry", "20");
                __builder.AddAttribute(5, "fill", "#3a8a3a");
                __builder.AddAttribute(6, "stroke", stroke); __builder.AddAttribute(7, "stroke-width", sw);
                __builder.CloseElement();
                break;

            case "SentientEgg":
                __builder.OpenElement(0, "ellipse");
                __builder.AddAttribute(1, "cx", "50"); __builder.AddAttribute(2, "cy", "55");
                __builder.AddAttribute(3, "rx", "22"); __builder.AddAttribute(4, "ry", "30");
                __builder.AddAttribute(5, "fill", "#c8b400");
                __builder.AddAttribute(6, "stroke", stroke); __builder.AddAttribute(7, "stroke-width", sw);
                __builder.CloseElement();
                __builder.OpenElement(8, "circle");
                __builder.AddAttribute(9, "cx", "43"); __builder.AddAttribute(10, "cy", "48");
                __builder.AddAttribute(11, "r", "3"); __builder.AddAttribute(12, "fill", "#222");
                __builder.CloseElement();
                __builder.OpenElement(13, "circle");
                __builder.AddAttribute(14, "cx", "57"); __builder.AddAttribute(15, "cy", "48");
                __builder.AddAttribute(16, "r", "3"); __builder.AddAttribute(17, "fill", "#222");
                __builder.CloseElement();
                break;

            case "HexRabbit":
                // Small rounded body + 6 little leg stubs
                __builder.OpenElement(0, "ellipse");
                __builder.AddAttribute(1, "cx", "50"); __builder.AddAttribute(2, "cy", "60");
                __builder.AddAttribute(3, "rx", "16"); __builder.AddAttribute(4, "ry", "13");
                __builder.AddAttribute(5, "fill", "#b0a080");
                __builder.AddAttribute(6, "stroke", stroke); __builder.AddAttribute(7, "stroke-width", sw);
                __builder.CloseElement();
                // Ears
                __builder.OpenElement(8, "ellipse");
                __builder.AddAttribute(9, "cx", "44"); __builder.AddAttribute(10, "cy", "44");
                __builder.AddAttribute(11, "rx", "4"); __builder.AddAttribute(12, "ry", "10");
                __builder.AddAttribute(13, "fill", "#b0a080"); __builder.AddAttribute(14, "stroke", stroke); __builder.AddAttribute(15, "stroke-width", sw);
                __builder.CloseElement();
                __builder.OpenElement(16, "ellipse");
                __builder.AddAttribute(17, "cx", "56"); __builder.AddAttribute(18, "cy", "44");
                __builder.AddAttribute(19, "rx", "4"); __builder.AddAttribute(20, "ry", "10");
                __builder.AddAttribute(21, "fill", "#b0a080"); __builder.AddAttribute(22, "stroke", stroke); __builder.AddAttribute(23, "stroke-width", sw);
                __builder.CloseElement();
                // 6 legs (3 pairs)
                int[] lx = [38, 50, 62]; int[] ly = [73, 76, 73];
                for (int li = 0; li < 3; li++)
                {
                    __builder.OpenElement(24 + li * 6, "line");
                    __builder.AddAttribute(25 + li * 6, "x1", lx[li]); __builder.AddAttribute(26 + li * 6, "y1", "70");
                    __builder.AddAttribute(27 + li * 6, "x2", lx[li]); __builder.AddAttribute(28 + li * 6, "y2", ly[li]);
                    __builder.AddAttribute(29 + li * 6, "stroke", stroke); __builder.AddAttribute(30 + li * 6, "stroke-width", 2);
                    __builder.CloseElement();
                }
                break;

            case "BeaverSerpent":
                // Wide flat body
                __builder.OpenElement(0, "rect");
                __builder.AddAttribute(1, "x", "28"); __builder.AddAttribute(2, "y", "50");
                __builder.AddAttribute(3, "width", "44"); __builder.AddAttribute(4, "height", "25");
                __builder.AddAttribute(5, "rx", "8"); __builder.AddAttribute(6, "ry", "8");
                __builder.AddAttribute(7, "fill", "#7a6040");
                __builder.AddAttribute(8, "stroke", stroke); __builder.AddAttribute(9, "stroke-width", sw);
                __builder.CloseElement();
                // Snake head on top
                __builder.OpenElement(10, "ellipse");
                __builder.AddAttribute(11, "cx", "50"); __builder.AddAttribute(12, "cy", "40");
                __builder.AddAttribute(13, "rx", "14"); __builder.AddAttribute(14, "ry", "9");
                __builder.AddAttribute(15, "fill", "#5a8050");
                __builder.AddAttribute(16, "stroke", stroke); __builder.AddAttribute(17, "stroke-width", sw);
                __builder.CloseElement();
                // Forked tongue
                __builder.OpenElement(18, "line");
                __builder.AddAttribute(19, "x1", "50"); __builder.AddAttribute(20, "y1", "33");
                __builder.AddAttribute(21, "x2", "46"); __builder.AddAttribute(22, "y2", "28");
                __builder.AddAttribute(23, "stroke", "#c04040"); __builder.AddAttribute(24, "stroke-width", 1.5);
                __builder.CloseElement();
                __builder.OpenElement(25, "line");
                __builder.AddAttribute(26, "x1", "50"); __builder.AddAttribute(27, "y1", "33");
                __builder.AddAttribute(28, "x2", "54"); __builder.AddAttribute(29, "y2", "28");
                __builder.AddAttribute(30, "stroke", "#c04040"); __builder.AddAttribute(31, "stroke-width", 1.5);
                __builder.CloseElement();
                // Flat beaver tail
                __builder.OpenElement(32, "ellipse");
                __builder.AddAttribute(33, "cx", "50"); __builder.AddAttribute(34, "cy", "82");
                __builder.AddAttribute(35, "rx", "18"); __builder.AddAttribute(36, "ry", "7");
                __builder.AddAttribute(37, "fill", "#6a5030");
                __builder.AddAttribute(38, "stroke", stroke); __builder.AddAttribute(39, "stroke-width", sw);
                __builder.CloseElement();
                break;

            case "MushroomSprite":
                // Stem
                __builder.OpenElement(0, "rect");
                __builder.AddAttribute(1, "x", "44"); __builder.AddAttribute(2, "y", "58");
                __builder.AddAttribute(3, "width", "12"); __builder.AddAttribute(4, "height", "20");
                __builder.AddAttribute(5, "rx", "4");
                __builder.AddAttribute(6, "fill", "#d4c0a0");
                __builder.AddAttribute(7, "stroke", stroke); __builder.AddAttribute(8, "stroke-width", sw);
                __builder.CloseElement();
                // Cap
                __builder.OpenElement(9, "ellipse");
                __builder.AddAttribute(10, "cx", "50"); __builder.AddAttribute(11, "cy", "52");
                __builder.AddAttribute(12, "rx", "24"); __builder.AddAttribute(13, "ry", "14");
                __builder.AddAttribute(14, "fill", "#c04060");
                __builder.AddAttribute(15, "stroke", stroke); __builder.AddAttribute(16, "stroke-width", sw);
                __builder.CloseElement();
                // Spots
                __builder.OpenElement(17, "circle"); __builder.AddAttribute(18, "cx", "43"); __builder.AddAttribute(19, "cy", "48"); __builder.AddAttribute(20, "r", "3"); __builder.AddAttribute(21, "fill", "#fff8"); __builder.CloseElement();
                __builder.OpenElement(22, "circle"); __builder.AddAttribute(23, "cx", "54"); __builder.AddAttribute(24, "cy", "44"); __builder.AddAttribute(25, "r", "4"); __builder.AddAttribute(26, "fill", "#fff8"); __builder.CloseElement();
                __builder.OpenElement(27, "circle"); __builder.AddAttribute(28, "cx", "62"); __builder.AddAttribute(29, "cy", "50"); __builder.AddAttribute(30, "r", "2.5"); __builder.AddAttribute(31, "fill", "#fff8"); __builder.CloseElement();
                break;

            case "DustWraith":
                // Wispy column — three stacked ellipses, getting thinner toward top
                __builder.OpenElement(0, "ellipse");
                __builder.AddAttribute(1, "cx", "50"); __builder.AddAttribute(2, "cy", "72");
                __builder.AddAttribute(3, "rx", "22"); __builder.AddAttribute(4, "ry", "10");
                __builder.AddAttribute(5, "fill", "#c8b880"); __builder.AddAttribute(6, "opacity", "0.6");
                __builder.AddAttribute(7, "stroke", stroke); __builder.AddAttribute(8, "stroke-width", sw);
                __builder.CloseElement();
                __builder.OpenElement(9, "ellipse");
                __builder.AddAttribute(10, "cx", "50"); __builder.AddAttribute(11, "cy", "55");
                __builder.AddAttribute(12, "rx", "14"); __builder.AddAttribute(13, "ry", "9");
                __builder.AddAttribute(14, "fill", "#c8b880"); __builder.AddAttribute(15, "opacity", "0.75");
                __builder.AddAttribute(16, "stroke", stroke); __builder.AddAttribute(17, "stroke-width", sw);
                __builder.CloseElement();
                __builder.OpenElement(18, "ellipse");
                __builder.AddAttribute(19, "cx", "50"); __builder.AddAttribute(20, "cy", "40");
                __builder.AddAttribute(21, "rx", "8"); __builder.AddAttribute(22, "ry", "8");
                __builder.AddAttribute(23, "fill", "#e0d090"); __builder.AddAttribute(24, "opacity", "0.9");
                __builder.AddAttribute(25, "stroke", stroke); __builder.AddAttribute(26, "stroke-width", sw);
                __builder.CloseElement();
                break;

            case "Wolf":
                __builder.OpenElement(0, "polygon");
                __builder.AddAttribute(1, "points", "50,20 72,50 65,80 35,80 28,50");
                __builder.AddAttribute(2, "fill", "#888");
                __builder.AddAttribute(3, "stroke", stroke); __builder.AddAttribute(4, "stroke-width", sw);
                __builder.CloseElement();
                break;

            case "Bear":
                __builder.OpenElement(0, "rect");
                __builder.AddAttribute(1, "x", "18"); __builder.AddAttribute(2, "y", "22");
                __builder.AddAttribute(3, "width", "64"); __builder.AddAttribute(4, "height", "58");
                __builder.AddAttribute(5, "rx", "12"); __builder.AddAttribute(6, "ry", "12");
                __builder.AddAttribute(7, "fill", "#8B4513");
                __builder.AddAttribute(8, "stroke", stroke); __builder.AddAttribute(9, "stroke-width", sw);
                __builder.CloseElement();
                break;

            case "CaveTroll":
            default:
                __builder.OpenElement(0, "polygon");
                __builder.AddAttribute(1, "points", "50,10 70,28 80,55 65,85 35,85 20,55 30,28");
                __builder.AddAttribute(2, "fill", "#4a4a3a");
                __builder.AddAttribute(3, "stroke", stroke); __builder.AddAttribute(4, "stroke-width", sw);
                __builder.CloseElement();
                break;
        }
    };
}
