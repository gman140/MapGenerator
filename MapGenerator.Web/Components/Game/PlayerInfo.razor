@using MapGenerator.Application.Services
@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Interfaces
@using MapGenerator.Domain.Models
@using static MapGenerator.Application.Services.DanceService
@implements IDisposable

<div class="player-info">
    <div class="player-companion-container">
        <div class="player-name">
            <button class="sprite-edit-btn" title="Edit your sprite" @onclick="async () => await OnEditSprite.InvokeAsync()">
                <SpriteView Pixels="@Player.SpritePixels" Size="32" Class="sprite-edit-preview" />
            </button>
            <div class="player-name-details">
                <span>@Player.Username</span>
                @if (Player.IsAdmin) { <span class="admin-badge">admin</span> }
                @{ var selfTitle = GetTitle(Player.EggsDestroyed); }
                @if (selfTitle != null) { <span class="egg-title">@selfTitle</span> }
            </div>
        </div>
        @if (Companion != null)
        {
            <div class="companion-inline" @onclick="async () => await OnOpenCompanion.InvokeAsync()">
                @if (Companion.SpritePixels.Any(p => !string.IsNullOrEmpty(p)))
                {
                    <SpriteView Pixels="@Companion.SpritePixels" Size="32" Class="companion-inline-sprite" />
                }
                else
                {
                    <span class="companion-inline-emoji">🐾</span>
                }
                <span class="companion-inline-name">@Companion.Nickname</span>
            </div>
        }
    </div>

    <PlayerStatusBars Player="Player" CooldownUntil="CooldownUntil" />

    @if (OnlinePlayers.Count > 0)
    {
        <div class="players-here">
            <span class="section-label">Here:</span>
            @foreach (var (id, username, eggsDestroyed, otherHasCompanion) in OnlinePlayers)
            {
                <span class="player-chip @(id == Player.Id ? "self" : "")">
                    @username
                    @if (id != Player.Id)
                    {
                        var capturedId = id;
                        var capturedName = username;
                        <button class="kiss-btn" disabled="@(_kissRemainingMs > 0)"
                                @onclick="async () => await OnKissPlayer.InvokeAsync((capturedId, capturedName))">
                            @(_kissRemainingMs > 0 ? $"💋 {(_kissRemainingMs / 1000.0):F0}s" : "💋")
                        </button>
                        @if (HasCompanion && otherHasCompanion)
                        {
                            <button class="battle-btn" title="Challenge @username's companion"
                                    @onclick="async () => await OnBattlePlayer.InvokeAsync((capturedId, capturedName))">
                                ⚔
                            </button>
                        }
                    }
                </span>
            }
        </div>
    }

    @if (Player.IsAdmin)
    {
        <a href="/admin" class="admin-link">Admin Panel</a>
    }
</div>

@code {
    private static readonly TimeSpan KissCooldown = TimeSpan.FromMinutes(1);

    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public long CooldownUntil { get; set; }
    [Parameter] public DateTime? LastKissedAt { get; set; }
    [Parameter] public List<(string Id, string Username, int EggsDestroyed, bool HasCompanion)> OnlinePlayers { get; set; } = [];
    [Parameter] public EventCallback OnEditSprite { get; set; }
    [Parameter] public PlayerCompanion? Companion { get; set; }
    [Parameter] public bool HasCompanion { get; set; }
    [Parameter] public EventCallback OnOpenCompanion { get; set; }
    [Parameter] public EventCallback<(string Id, string Username)> OnKissPlayer { get; set; }
    [Parameter] public EventCallback<(string Id, string Username)> OnBattlePlayer { get; set; }

    private long _kissRemainingMs;
    private long _kissEndMs;
    private System.Threading.Timer? _timer;

    protected override void OnParametersSet()
    {
        long now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        if (LastKissedAt.HasValue)
        {
            _kissEndMs = new DateTimeOffset(LastKissedAt.Value.ToUniversalTime()).ToUnixTimeMilliseconds()
                         + (long)KissCooldown.TotalMilliseconds;
            _kissRemainingMs = Math.Max(0, _kissEndMs - now);
        }
        else
        {
            _kissRemainingMs = 0;
            _kissEndMs = 0;
        }

        if (_kissRemainingMs > 0 && _timer == null)
            _timer = new System.Threading.Timer(Tick, null, 100, 100);
        else if (_kissRemainingMs <= 0)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private void Tick(object? _)
    {
        _kissRemainingMs = Math.Max(0, _kissEndMs - DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
        if (_kissRemainingMs <= 0) { _timer?.Dispose(); _timer = null; }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _timer?.Dispose();
}
