@using MapGenerator.Application.Services
@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Interfaces
@using MapGenerator.Domain.Models
@inject MapGeneratorService MapCache
@inject IFeatureDefinitionProvider FeatureProvider
@inject SettlementCacheService SettlementCache
@using static MapGenerator.Application.Services.DanceService
@using static MapGenerator.Application.Services.HungerService
@implements IDisposable

<div class="player-info">
    <div class="player-name">
        <button class="sprite-edit-btn" title="Edit your sprite" @onclick="async () => await OnEditSprite.InvokeAsync()">
            <svg width="32" height="32" class="sprite-edit-preview">
                @for (int i = 0; i < 256 && i < Player.SpritePixels.Length; i++)
                {
                    if (!string.IsNullOrEmpty(Player.SpritePixels[i]))
                    {
                        int px = i % 16, py = i / 16;
                        <rect x="@(px * 2)" y="@(py * 2)" width="2" height="2" fill="@Player.SpritePixels[i]" />
                    }
                }
            </svg>
        </button>
        <span>@Player.Username</span>
        @if (Player.IsAdmin) { <span class="admin-badge">admin</span> }
        @{ var selfTitle = GetTitle(Player.EggsDestroyed); }
        @if (selfTitle != null) { <span class="egg-title">@selfTitle</span> }
    </div>
    <div class="tile-info">
        @{
            var tile = MapCache.GetCachedTile(Player.Q, Player.R);
            var featureDef = FeatureProvider.GetById(tile?.FeatureId);
            var (settlementName, _) = SettlementCache.GetSettlementTile(Player.Q, Player.R);
        }
        <span class="biome-tag biome-@(tile?.Biome.ToString().ToLower() ?? "unknown")">
            @(tile?.Biome.ToString() ?? "Unknown")
        </span>
        @if (featureDef != null)
        {
            <span class="feature-tag">@featureDef.GetDisplayName(Player.Q, Player.R)</span>
        }
        @if (settlementName != null)
        {
            <span class="settlement-tag">@settlementName</span>
        }
        <span class="coords">(@Player.Q, @Player.R)</span>
    </div>

    @{
        var hungerBand = GetBand(Player.Satiety);
        var hungerLabel = hungerBand switch
        {
            HungerBand.Stuffed  => "Stuffed",
            HungerBand.Satiated => "Satiated",
            HungerBand.Peckish  => "Peckish",
            HungerBand.Hungry   => "Hungry",
            _                   => "Starving",
        };
    }
    <div class="hunger-bar">
        <div class="hunger-fill hunger-@hungerBand.ToString().ToLower()"
             style="width: @Player.Satiety.ToString("F0")%"></div>
        <span class="hunger-text">@hungerLabel</span>
    </div>

    <div class="xp-bar-row">
        @{
            int xpForNext = Player.Level < 20 ? Player.Level * 60 : 1;
            double xpPct  = Player.Level < 20 ? Math.Min(100, Player.Experience * 100.0 / xpForNext) : 100;
        }
        <span class="xp-level-label">Lv @Player.Level</span>
        <div class="xp-bar">
            <div class="xp-fill" style="width: @xpPct.ToString("F1")%"></div>
        </div>
        @if (Player.Level < 20)
        {
            <span class="xp-text">@Player.Experience / @xpForNext XP</span>
        }
        else
        {
            <span class="xp-text">MAX</span>
        }
        @if (Player.UnspentStatPoints > 0)
        {
            <span class="xp-points-badge">@Player.UnspentStatPoints pts</span>
        }
        <button class="xp-stats-btn" title="Character stats" @onclick="async () => await OnOpenStats.InvokeAsync()">⚔</button>
    </div>

    @if (Player.ActiveBuffs.Count > 0)
    {
        <div class="active-buffs">
            @foreach (var buff in Player.ActiveBuffs)
            {
                <span class="buff-chip buff-@buff.Type.ToString().ToLower()">
                    @FormatActiveBuff(buff)
                </span>
            }
        </div>
    }

    @if (_stunnedRemaining > 0)
    {
        <div class="stun-bar">
            <div class="stun-fill" style="width: @(_stunnedRemaining / 60000.0 * 100.0)%"></div>
            <span class="stun-text">💥 Stunned @((_stunnedRemaining / 1000.0).ToString("F1"))s</span>
        </div>
    }

    @if (_cooldownRemaining > 0)
    {
        <div class="cooldown-bar">
            <div class="cooldown-fill" style="width: @_fillPct%"></div>
            <span class="cooldown-text">@((_cooldownRemaining / 1000.0).ToString("F1"))s</span>
        </div>
    }

    @if (OnlinePlayers.Count > 0)
    {
        <div class="players-here">
            <span class="section-label">Here:</span>
            @foreach (var (id, username, eggsDestroyed) in OnlinePlayers)
            {
                <span class="player-chip @(id == Player.Id ? "self" : "")">
                    @username
                    @{ var chipTitle = GetTitle(eggsDestroyed); }
                    @if (chipTitle != null)
                    {
                        <span class="egg-title-small">@chipTitle</span>
                    }
                    @if (id != Player.Id)
                    {
                        var capturedId = id;
                        var capturedName = username;
                        <button class="kiss-btn" disabled="@(_kissRemainingMs > 0)"
                                @onclick="async () => await OnKissPlayer.InvokeAsync((capturedId, capturedName))">
                            @(_kissRemainingMs > 0 ? $"💋 {(_kissRemainingMs / 1000.0):F0}s" : "💋")
                        </button>
                    }
                </span>
            }
        </div>
    }

    @if (Player.IsAdmin)
    {
        <a href="/admin" class="admin-link">Admin Panel</a>
    }
</div>

@code {
    private static readonly TimeSpan KissCooldown = TimeSpan.FromMinutes(1);

    [Parameter, EditorRequired] public Player Player { get; set; } = null!;
    [Parameter] public long CooldownUntil { get; set; }
    [Parameter] public DateTime? LastKissedAt { get; set; }
    [Parameter] public List<(string Id, string Username, int EggsDestroyed)> OnlinePlayers { get; set; } = [];
    [Parameter] public EventCallback OnEditSprite { get; set; }
    [Parameter] public EventCallback OnOpenStats { get; set; }
    [Parameter] public EventCallback<(string Id, string Username)> OnKissPlayer { get; set; }

    private long _cooldownRemaining;
    private double _fillPct;
    private long _cooldownDuration;
    private long _kissRemainingMs;
    private long _kissEndMs;
    private long _stunnedRemaining;
    private System.Threading.Timer? _timer;

    protected override void OnParametersSet()
    {
        long now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _cooldownRemaining = Math.Max(0, CooldownUntil - now);
        _cooldownDuration  = _cooldownRemaining > 0 ? _cooldownRemaining : _cooldownDuration;
        _stunnedRemaining  = Math.Max(0, Player.StunnedUntil - now);
        UpdateFill();

        if (LastKissedAt.HasValue)
        {
            _kissEndMs = new DateTimeOffset(LastKissedAt.Value.ToUniversalTime()).ToUnixTimeMilliseconds()
                         + (long)KissCooldown.TotalMilliseconds;
            _kissRemainingMs = Math.Max(0, _kissEndMs - now);
        }
        else
        {
            _kissRemainingMs = 0;
            _kissEndMs = 0;
        }

        bool needsTimer = _cooldownRemaining > 0 || _kissRemainingMs > 0 || _stunnedRemaining > 0;
        if (needsTimer && _timer == null)
            _timer = new System.Threading.Timer(Tick, null, 100, 100);
        else if (!needsTimer)
        {
            _timer?.Dispose();
            _timer = null;
        }
    }

    private void Tick(object? _)
    {
        long now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _cooldownRemaining = Math.Max(0, CooldownUntil - now);
        _kissRemainingMs   = Math.Max(0, _kissEndMs - now);
        _stunnedRemaining  = Math.Max(0, Player.StunnedUntil - now);
        UpdateFill();

        if (_cooldownRemaining <= 0 && _kissRemainingMs <= 0 && _stunnedRemaining <= 0)
        {
            _timer?.Dispose();
            _timer = null;
        }
        InvokeAsync(StateHasChanged);
    }

    private void UpdateFill()
    {
        _fillPct = _cooldownDuration > 0
            ? _cooldownRemaining / (double)_cooldownDuration * 100.0
            : 0;
    }

    private static string FormatActiveBuff(ActiveBuff buff) => buff.Type switch
    {
        BuffType.CooldownReduction    => $"⚡ CD −{(1 - buff.Magnitude) * 100:F0}% × {buff.RemainingCharges}",
        BuffType.GatherBonus          => $"🎯 Gather +{(buff.Magnitude - 1) * 100:F0}% × {buff.RemainingCharges}",
        BuffType.HungerDrainReduction => $"🌿 Hunger −{(1 - buff.Magnitude) * 100:F0}% × {buff.RemainingCharges}",
        _                             => buff.Type.ToString(),
    };

    public void Dispose() => _timer?.Dispose();
}
