@using MapGenerator.Domain.Enums
@using MapGenerator.Domain.Interfaces
@using MapGenerator.Domain.Models
@inject IItemRegistry Items
@inject ICraftingRecipeProvider RecipeProvider

@{
    int totalItems = Inventory.Where(kv => kv.Value > 0).Sum(kv => kv.Value)
                  + CraftedItems.Where(kv => kv.Value > 0).Sum(kv => kv.Value);
}
<button class="crafting-toggle" @onclick="() => _open = true">
    <span>📋 Inventory@(totalItems > 0 ? $" ({totalItems})" : "")</span>
</button>

@{
    var allItems   = Inventory.Concat(CraftedItems)
                              .GroupBy(kv => kv.Key)
                              .ToDictionary(g => g.Key, g => g.Sum(kv => kv.Value));
    var food       = allItems.Where(kv => kv.Value > 0 && Items.FindConsumable(kv.Key)?.SatietyRestore > 0)
                             .OrderBy(kv => kv.Key).ToList();
    var consumables= allItems.Where(kv => kv.Value > 0
                                       && Items.FindConsumable(kv.Key) is { SatietyRestore: <= 0 } c && c.UsableInCombat)
                             .OrderBy(kv => kv.Key).ToList();
    var materials  = allItems.Where(kv => kv.Value > 0
                                       && Items.FindConsumable(kv.Key) == null
                                       && Items.FindEquipment(kv.Key) == null)
                             .OrderBy(kv => kv.Key).ToList();
    var crafted    = allItems.Where(kv => kv.Value > 0
                                       && RecipeProvider.GetById(kv.Key) != null
                                       && Items.FindConsumable(kv.Key) == null
                                       && Items.FindEquipment(kv.Key) == null)
                             .OrderBy(kv => kv.Key).ToList();

    var weaponItems = allItems.Where(kv => kv.Value > 0 && Items.FindEquipment(kv.Key)?.EquipmentSlot == "Weapon").OrderBy(kv => kv.Key).ToList();
    var armorItems  = allItems.Where(kv => kv.Value > 0 && Items.FindEquipment(kv.Key)?.EquipmentSlot == "Armor").OrderBy(kv => kv.Key).ToList();
    var hatItems    = allItems.Where(kv => kv.Value > 0 && Items.FindEquipment(kv.Key)?.EquipmentSlot == "Hat").OrderBy(kv => kv.Key).ToList();
}
@if (_open)
{
    <div class="modal-overlay" @onclick="() => _open = false">
        <div class="modal-box inv-modal" @onclick:stopPropagation>
            <div class="crafting-modal-header">
                <h3 class="modal-title">Inventory</h3>
                <button class="crafting-modal-close" @onclick="() => _open = false">✕</button>
            </div>

            <div class="inv-tabs">
                <button class="inv-tab @(_tab == 0 ? "active" : "")" @onclick="() => _tab = 0">Items</button>
                <button class="inv-tab @(_tab == 1 ? "active" : "")" @onclick="() => _tab = 1">Equipment</button>
            </div>

            @if (_tab == 0)
            {
                @if (food.Count == 0 && consumables.Count == 0 && materials.Count == 0 && crafted.Count == 0)
                {
                    <p class="inventory-empty">Nothing gathered yet.</p>
                }
                @if (food.Count > 0)
                {
                    <p class="inventory-section-label">Food</p>
                    <div class="inv-modal-list">
                        @foreach (var (id, qty) in food)
                        {
                            var def        = Items.FindConsumable(id)!;
                            var matDef     = Items.FindMaterial(id);
                            var recipeDef  = RecipeProvider.GetById(id);
                            var name       = matDef?.Name ?? recipeDef?.Name ?? def.Name;
                            var desc       = matDef?.Description ?? recipeDef?.Description ?? def.Description;
                            var capturedId = id;
                            <div class="inv-modal-item">
                                <div class="inv-modal-item-header">
                                    <span class="inv-modal-name">@name</span>
                                    <span class="inv-modal-qty">×@qty</span>
                                    <button class="eat-btn" @onclick="() => OnUse.InvokeAsync(capturedId)">Eat</button>
                                </div>
                                @if (!string.IsNullOrEmpty(desc))
                                {
                                    <p class="inv-modal-desc">@desc</p>
                                }
                                @if (def.Buff != null)
                                {
                                    <p class="inv-modal-buff">@FormatBuff(def.Buff)</p>
                                }
                            </div>
                        }
                    </div>
                }
                @if (consumables.Count > 0)
                {
                    <p class="inventory-section-label">Consumables</p>
                    <div class="inv-modal-list">
                        @foreach (var (id, qty) in consumables)
                        {
                            var def        = Items.FindConsumable(id)!;
                            var matDef     = Items.FindMaterial(id);
                            var name       = matDef?.Name ?? def.Name;
                            var desc       = matDef?.Description ?? def.Description;
                            <div class="inv-modal-item">
                                <div class="inv-modal-item-header">
                                    <span class="inv-modal-name">@name</span>
                                    <span class="inv-modal-qty">×@qty</span>
                                    @if (!string.IsNullOrEmpty(def.CombatBuffLabel))
                                    {
                                        <span class="inv-modal-buff">@def.CombatBuffLabel</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(desc))
                                {
                                    <p class="inv-modal-desc">@desc</p>
                                }
                            </div>
                        }
                    </div>
                }
                @if (materials.Count > 0)
                {
                    <p class="inventory-section-label">Materials</p>
                    <div class="inv-modal-list">
                        @foreach (var (id, qty) in materials)
                        {
                            var def = Items.FindMaterial(id);
                            if (def == null) continue;
                            <div class="inv-modal-item">
                                <div class="inv-modal-item-header">
                                    <span class="inv-modal-name">@def.Name</span>
                                    <span class="inv-modal-qty">×@qty</span>
                                </div>
                                @if (!string.IsNullOrEmpty(def.Description))
                                {
                                    <p class="inv-modal-desc">@def.Description</p>
                                }
                            </div>
                        }
                    </div>
                }
                @if (crafted.Count > 0)
                {
                    <p class="inventory-section-label">Crafted</p>
                    <div class="inv-modal-list">
                        @foreach (var (id, qty) in crafted)
                        {
                            var def = RecipeProvider.GetById(id)!;
                            <div class="inv-modal-item">
                                <div class="inv-modal-item-header">
                                    <span class="inv-modal-name">@def.Name</span>
                                    <span class="inv-modal-qty">×@qty</span>
                                </div>
                                @if (!string.IsNullOrEmpty(def.Description))
                                {
                                    <p class="inv-modal-desc">@def.Description</p>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="inv-equipment">
                    @RenderEquipSlot("Weapon", "⚔ Weapon", EquippedWeaponId, weaponItems)
                    @RenderEquipSlot("Armor", "🛡 Armor", EquippedArmorId, armorItems)
                    @RenderEquipSlot("Hat", "🎩 Hat", EquippedHatId, hatItems)
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Dictionary<string, int> Inventory { get; set; } = null!;
    [Parameter] public Dictionary<string, int> CraftedItems { get; set; } = new();
    [Parameter] public string? EquippedWeaponId { get; set; }
    [Parameter] public string? EquippedArmorId { get; set; }
    [Parameter] public string? EquippedHatId { get; set; }
    [Parameter] public EventCallback<string> OnUse { get; set; }
    [Parameter] public EventCallback<string> OnEquip { get; set; }
    [Parameter] public EventCallback<string> OnUnequip { get; set; }

    private bool _open;
    private int _tab;

    private RenderFragment RenderEquipSlot(string slot, string label, string? equippedId, List<KeyValuePair<string, int>> available) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "equip-slot");

        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "class", "equip-slot-header");
        __builder.OpenElement(4, "span");
        __builder.AddAttribute(5, "class", "equip-slot-label");
        __builder.AddContent(6, label);
        __builder.CloseElement();

        if (equippedId != null)
        {
            var def  = Items.FindEquipment(equippedId);
            var name = def?.Name ?? equippedId;
            __builder.OpenElement(7, "span");
            __builder.AddAttribute(8, "class", "equip-slot-equipped");
            __builder.AddContent(9, name);
            __builder.CloseElement();
            var capturedSlot = slot;
            __builder.OpenElement(10, "button");
            __builder.AddAttribute(11, "class", "equip-unequip-btn");
            __builder.AddAttribute(12, "onclick", EventCallback.Factory.Create(this, () => OnUnequip.InvokeAsync(capturedSlot)));
            __builder.AddContent(13, "Unequip");
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(7, "span");
            __builder.AddAttribute(8, "class", "equip-slot-empty");
            __builder.AddContent(9, "Empty");
            __builder.CloseElement();
        }
        __builder.CloseElement(); // equip-slot-header

        if (available.Count > 0)
        {
            __builder.OpenElement(14, "div");
            __builder.AddAttribute(15, "class", "equip-available");
            int seq = 16;
            foreach (var (id, qty) in available)
            {
                var def       = Items.FindEquipment(id);
                var name      = def?.Name ?? id;
                bool isEquipped = id == equippedId;
                var capturedId  = id;
                __builder.OpenElement(seq++, "div");
                __builder.AddAttribute(seq++, "class", "equip-available-item");
                __builder.OpenElement(seq++, "span");
                __builder.AddAttribute(seq++, "class", "inv-modal-name");
                __builder.AddContent(seq++, name);
                __builder.CloseElement();
                if (def != null && def.Affixes.Count > 0)
                {
                    __builder.OpenElement(seq++, "span");
                    __builder.AddAttribute(seq++, "class", "equip-stat-hint");
                    __builder.AddContent(seq++, FormatEquipStats(def));
                    __builder.CloseElement();
                }
                __builder.OpenElement(seq++, "button");
                __builder.AddAttribute(seq++, "class", "equip-equip-btn");
                __builder.AddAttribute(seq++, "disabled", isEquipped);
                __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnEquip.InvokeAsync(capturedId)));
                __builder.AddContent(seq++, isEquipped ? "Equipped" : "Equip");
                __builder.CloseElement();
                __builder.CloseElement(); // equip-available-item
            }
            __builder.CloseElement(); // equip-available
        }

        __builder.CloseElement(); // equip-slot
    };

    private static string FormatEquipStats(EquipmentDefinition def)
    {
        var parts = new List<string>();
        foreach (var affix in def.Affixes)
        {
            parts.Add(affix.Stat switch
            {
                ModifierStat.Attack      => $"+{(int)affix.Value} Atk",
                ModifierStat.Magic       => $"+{(int)affix.Value} Mag",
                ModifierStat.Defense     => $"+{(int)affix.Value} Def",
                ModifierStat.Resistance  => $"+{(int)affix.Value} Res",
                ModifierStat.DodgeChance => $"+{affix.Value * 100:F0}% Dodge",
                ModifierStat.StaminaRegen=> $"+{(int)affix.Value} Stam/turn",
                ModifierStat.ManaRegen   => $"+{(int)affix.Value} Mana/turn",
                ModifierStat.HpRegen     => $"+{(int)affix.Value} HP/turn",
                ModifierStat.HealBonus   => $"+{affix.Value * 100:F0}% Heal",
                _                        => $"+{affix.Value} {affix.Stat}",
            });
        }
        if (def.EquipmentSlot == "Weapon")
            parts.Add(FormatDamageType(def.WeaponDamageType));
        return string.Join(" · ", parts);
    }

    private static string FormatDamageType(DamageType dt) => dt switch
    {
        DamageType.Bludgeoning => "🔨 Bludgeoning",
        DamageType.Piercing    => "🏹 Piercing",
        DamageType.Slashing    => "⚔️ Slashing",
        DamageType.Fire        => "🔥 Fire",
        DamageType.Frost       => "❄️ Frost",
        DamageType.Storm       => "⚡ Storm",
        DamageType.Nature      => "🌿 Nature",
        DamageType.Dark        => "🌑 Dark",
        _                      => dt.ToString(),
    };

    private static string FormatBuff(BuffDefinition buff) => buff.Type switch
    {
        BuffType.CooldownReduction    => $"⚡ Cooldown −{(1 - buff.Magnitude) * 100:F0}% for {buff.Charges} actions",
        BuffType.GatherBonus          => $"🎯 Gather +{(buff.Magnitude - 1) * 100:F0}% for {buff.Charges} gathers",
        BuffType.HungerDrainReduction => $"🌿 Hunger drain −{(1 - buff.Magnitude) * 100:F0}% for {buff.Charges} actions",
        _                             => string.Empty,
    };
}
